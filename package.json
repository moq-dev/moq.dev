{
	"name": "moq.dev",
	"type": "module",
	"version": "0.0.1",
	"private": true,
	"workspaces": [
		"moq/js/clock",
		"moq/js/flate",
		"moq/js/hang",
		"moq/js/json",
		"moq/js/libav",
		"moq/js/loc",
		"moq/js/moq-boy",
		"moq/js/msf",
		"moq/js/net",
		"moq/js/pattern",
		"moq/js/publish",
		"moq/js/qmux",
		"moq/js/signals",
		"moq/js/ui",
		"moq/js/video",
		"moq/js/watch"
	],
	"scripts": {
		"dev": "astro dev --open",
		"dev:pub": "vite sites/pub",
		"dev:watch": "vite sites/watch",
		"build": "astro build --production",
		"preview": "wrangler pages dev ./dist",
		"deploy": "wrangler deploy",
		"prod": "astro build --production && wrangler pages dev ./dist --open",
		"check": "biome ci && tsc --noEmit --runExternalCode",
		"fix": "biome check --write && bun audit fix",
		"postinstall": "bun run --cwd moq/js/libav build"
	},
	"dependencies": {
		"@moq/boy": "workspace:*",
		"@moq/json": "workspace:*",
		"@moq/publish": "workspace:*",
		"@moq/watch": "workspace:*",
		"astro": "^7.4.2",
		"highlight.js": "^11.12.0",
		"solid-js": "^1.9.17"
	},
	"devDependencies": {
		"@astrojs/mdx": "8.1.1",
		"@astrojs/rss": "^4.0.19",
		"@astrojs/solid-js": "7.1.1",
		"@astrojs/ts-content-mapper": "^0.2.0",
		"@biomejs/biome": "^2.6.2",
		"@microsoft/api-extractor": "7.59.4",
		"@tailwindcss/forms": "^0.5.11",
		"@tailwindcss/typography": "^0.5.20",
		"@tailwindcss/vite": "^4.3.3",
		"@types/bun": "^1.4.3",
		"@types/node": "^26.6.5",
		"rolldown": "^1.2.14",
		"sharp": "^0.35.5",
		"shiki": "^4.5.0",
		"tailwindcss": "^4.3.3",
		"typescript": "7.1.0-beta",
		"vite": "^8.3.4",
		"wrangler": "^4.151.3"
	},
	"packageManager": "bun@1.4.2"
}
