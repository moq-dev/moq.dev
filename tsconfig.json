{
	"extends": "astro/tsconfigs/strict",
	"exclude": ["**/dist", "node_modules", "moq"],
	"compilerOptions": {
		"jsx": "preserve",
		"jsxImportSource": "solid-js",
		"esModuleInterop": true,
		"types": ["bun"],
		"paths": {
			"@/*": ["./src/*"]
		}
	},
	"contentMappers": [
		{
			"package": "@astrojs/ts-content-mapper",
			"extensions": [".astro"]
		}
	]
}
