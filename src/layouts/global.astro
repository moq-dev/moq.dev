---
import MotionToggle from "@/components/motion-toggle.astro";
import "./global.css";

// NOTE: This is magically used as the type for Astro.props
interface Props {
	title: string;
	description: string;
	// The page draws its own layout instead of sitting in the reading column.
	bare?: boolean;

	frontmatter?: {
		title: string;
		date: string;
		description: string;
		author?: string;
		cover?: string;
	};
}

let { title, frontmatter, description, bare } = Astro.props;
if (frontmatter?.title) title = frontmatter.title;
if (frontmatter?.description) description = frontmatter.description;

const siteUrl = Astro.site?.toString().replace(/\/$/, "") ?? "https://moq.dev";
const pageUrl = new URL(Astro.url.pathname, siteUrl).toString();
const fullTitle = title ? `${title} - Media over QUIC` : "Media over QUIC";
const fullDescription = description
	? `Media over QUIC: ${description}`
	: "Media over QUIC is a new live media protocol designed for simplicity and scale. It uses new browser technologies like WebTransport and WebCodecs to deliver media with latency that rivals WebRTC.";
// An SVG cover is served as the PNG that pages/og renders from it.
const cover = frontmatter?.cover?.replace(/^(.*)\.svg$/, "/og$1.png");
const ogImage = new URL(cover ?? "/layout/og.png", siteUrl).toString();

// moq.wtf for staging builds, moq.pro for live (and local dev).
const proUrl = import.meta.env.MODE === "staging" ? "https://moq.wtf" : "https://moq.pro";

const path = Astro.url.pathname;
const useCasePaths = ["/robotics", "/distribution", "/contribution", "/ai", "/interactive", "/conferencing"];
const nav = [
	{ href: "/demo", word: "Demos" },
	{ href: "/blog", word: "Blog" },
	{ href: "https://doc.moq.dev", word: "Docs" },
	{ href: "/#use-cases", word: "Use cases" },
];
const isActive = (href: string) =>
	href === "/#use-cases" ? useCasePaths.some((p) => path.startsWith(p)) : path.startsWith(href);
const date = frontmatter?.date
	? new Date(frontmatter.date).toLocaleDateString("en-US", {
			year: "numeric",
			month: "long",
			day: "numeric",
			timeZone: "UTC",
		})
	: undefined;
---

<!doctype html>
<html lang="en" class="sl-theme-dark">
	<head>
		<meta charset="UTF-8" />
		<meta name="description" content={fullDescription} />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" type="image/svg+xml" href="/layout/favicon.svg" />
		<link rel="icon" type="image/png" href="/layout/favicon.png" />
		<link rel="alternate" type="application/rss+xml" title="moq.dev RSS Feed" href={new URL("rss.xml", Astro.site)} />
		<meta name="generator" content={Astro.generator} />
		<title>{fullTitle}</title>

		<!-- Open Graph -->
		<meta property="og:type" content={frontmatter?.date ? "article" : "website"} />
		<meta property="og:title" content={fullTitle} />
		<meta property="og:description" content={fullDescription} />
		<meta property="og:url" content={pageUrl} />
		<meta property="og:site_name" content="Media over QUIC" />
		<!-- No og:image:width/height: covers live in public/ at whatever size they
		were drawn, so any hardcoded pair is a lie for most pages. Scrapers measure
		the image themselves when the dimensions are absent; when they're present and
		wrong they're believed, and a card claiming to be smaller than Twitter's
		300x157 minimum gets downgraded to a thumbnail. -->
		<meta property="og:image" content={ogImage} />

		<!-- Twitter Card -->
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={fullTitle} />
		<meta name="twitter:description" content={fullDescription} />
		<meta name="twitter:image" content={ogImage} />

		<!-- Theme color -->
		<meta name="theme-color" content="#0f172a" />

		<!-- `.js` gates the scribble draw-in so underlines stay visible if scripts never run.
		The saved motion choice is applied before first paint so nothing starts and then stops. -->
		<script is:inline>
			(() => {
				const root = document.documentElement;
				root.classList.add("js");
				try {
					const motion = localStorage.getItem("motion");
					if (motion === "off") root.classList.add("still");
					if (motion === "on") root.classList.add("moving");
				} catch {}
			})();
		</script>
	</head>
	<body class="relative flex min-h-screen flex-col">
		<header class="sticky top-0 z-20 border-b border-line bg-bg/85 backdrop-blur-md">
			<div class="relative mx-auto flex max-w-6xl items-center justify-between gap-4 px-5 py-3 md:px-8">
				<a href="/" class="shrink-0 transition-opacity hover:opacity-85" aria-label="Media over QUIC home">
					<img src="/home/logo.svg" class="-mb-0.5 h-8 w-auto sm:h-9" alt="Media over QUIC" />
				</a>

				<nav class="hidden items-center gap-1 text-[0.92rem] font-medium text-ink-2 sm:gap-2 md:flex" aria-label="Main">
					{
						nav.map(({ href, word }) => (
							<a
								href={href}
								aria-current={isActive(href) ? "page" : undefined}
								class:list={[
									"rounded-md px-2.5 py-1.5 transition-colors hover:bg-tint hover:text-ink",
									isActive(href) && "text-ink underline decoration-accent decoration-2 underline-offset-[6px]",
								]}
							>
								{word}
							</a>
						))
					}
				</nav>

				<div class="flex items-center gap-2.5 sm:gap-4">
					<a
						href="https://github.com/moq-dev/moq"
						class="hidden items-center gap-1.5 opacity-90 transition hover:-translate-y-px hover:opacity-100 md:flex"
					>
						<img src="/layout/github-icon.svg" class="h-7 w-auto" alt="GitHub" />
						<span data-stat="stars" data-short class="font-mono text-[0.75rem] font-medium text-accent"></span>
					</a>
					<a
						href="https://discord.moq.dev"
						class="hidden items-center gap-1.5 opacity-90 transition hover:-translate-y-px hover:opacity-100 md:flex"
					>
						<img src="/layout/discord-icon.svg" class="h-7 w-auto" alt="Discord" />
						<span data-stat="chatters" data-short class="font-mono text-[0.75rem] font-medium text-accent"></span>
					</a>
					<a href={proUrl} class="btn-line whitespace-nowrap px-3.5! py-2! text-[0.875rem]!">
						<img src="/layout/pro-icon.svg" class="-my-1 -ml-1 h-5 w-auto" alt="" />
						moq.pro <span class="hidden sm:inline" aria-hidden="true">→</span>
					</a>
					<!-- Smaller screens get every nav and community link in a drop-down. -->
					<details class="menu md:hidden" data-menu>
						<summary aria-label="Menu">
							<span class="menu-bars" aria-hidden="true"><i /><i /><i /></span>
						</summary>
						<nav class="menu-panel" aria-label="Main">
							{
								nav.map(({ href, word }) => (
									<a
										href={href}
										aria-current={isActive(href) ? "page" : undefined}
										class:list={[
											"rounded-md px-2.5 py-2 text-[0.98rem] font-medium text-ink-2 transition-colors hover:bg-tint hover:text-ink",
											isActive(href) && "text-ink underline decoration-accent decoration-2 underline-offset-[6px]",
										]}
									>
										{word}
									</a>
								))
							}
							<div class="mt-2 flex items-center gap-5 border-t border-line px-2.5 pt-3">
								<a
									href="https://github.com/moq-dev/moq"
									class="inline-flex items-center gap-1.5 text-[0.9rem] text-ink-2 transition-colors hover:text-ink"
								>
									<img src="/layout/github-icon.svg" class="h-6 w-auto" alt="" />
									<span>GitHub</span>
									<span data-stat="stars" data-short class="font-mono text-[0.75rem] font-medium text-accent"></span>
								</a>
								<a
									href="https://discord.moq.dev"
									class="inline-flex items-center gap-1.5 text-[0.9rem] text-ink-2 transition-colors hover:text-ink"
								>
									<img src="/layout/discord-icon.svg" class="h-6 w-auto" alt="" />
									<span>Discord</span>
									<span data-stat="chatters" data-short class="font-mono text-[0.75rem] font-medium text-accent"></span>
								</a>
							</div>
						</nav>
					</details>
				</div>
			</div>
		</header>

		<main class="relative z-1 flex-1 overflow-x-clip">
			{
				bare ? (
					<slot />
				) : (
					<article class="markdown mx-auto max-w-176 px-5 pb-24 pt-14 md:px-0">
						{date && (
							<p class="label not-prose mb-5 flex flex-wrap items-center gap-x-2.5 gap-y-1">
								<a href="/blog" class="text-ink-2 no-underline transition-colors hover:text-accent-ink">
									<span aria-hidden="true">←</span> Blog
								</a>
								<span aria-hidden="true" class="text-line-strong">/</span>
								<time datetime={frontmatter?.date}>{date}</time>
								{frontmatter?.author && (
									<>
										<span aria-hidden="true" class="text-line-strong">/</span>
										<span>{frontmatter.author}</span>
									</>
								)}
							</p>
						)}
						<slot />
					</article>
				)
			}
		</main>

		<footer class="relative z-1 border-t border-line bg-surface">
			<!-- The MoQ cat, peeking over the edge to see if you're still watching. -->
			<div class="cat" aria-hidden="true" data-loop>
				<img src="/blog/open-for-business/viewers-1.svg" class="boil-always" alt="" />
			</div>
			<div class="mx-auto max-w-6xl px-5 py-14 md:px-8">
				<div class="grid gap-10 sm:grid-cols-2 md:grid-cols-[1.5fr_1fr_1fr_1fr]">
					<div class="flex flex-col items-start gap-4 sm:col-span-2 md:col-span-1">
						<img src="/home/logo.svg" class="h-8 w-auto" alt="Media over QUIC" />
						<p class="max-w-xs text-[0.9rem] leading-relaxed text-ink-3">
							Real-time latency at massive scale
						</p>
						<MotionToggle class="mt-1" />
					</div>
					<div class="flex flex-col gap-2 text-[0.9rem] text-ink-2">
						<span class="label mb-1">MoQ</span>
						<a href="/demo" class="transition-colors hover:text-ink">Demos</a>
						<a href="/blog" class="transition-colors hover:text-ink">Blog</a>
						<a href="https://doc.moq.dev" class="transition-colors hover:text-ink">Docs</a>
						<a href={proUrl} class="transition-colors hover:text-ink">moq.pro</a>
						<a href="https://datatracker.ietf.org/wg/moq/about/" class="transition-colors hover:text-ink">IETF</a>
					</div>
					<div class="flex flex-col gap-2 text-[0.9rem] text-ink-2">
						<span class="label mb-1">Use cases</span>
						<a href="/robotics" class="transition-colors hover:text-ink">Robotics</a>
						<a href="/distribution" class="transition-colors hover:text-ink">Distribution</a>
						<a href="/contribution" class="transition-colors hover:text-ink">Contribution</a>
						<a href="/ai" class="transition-colors hover:text-ink">Voice &amp; video AI</a>
						<a href="/interactive" class="transition-colors hover:text-ink">Interactive</a>
						<a href="/conferencing" class="transition-colors hover:text-ink">Conferencing</a>
					</div>
					<div class="flex flex-col gap-2 text-[0.9rem] text-ink-2">
						<span class="label mb-1">Community</span>
						<a href="https://github.com/moq-dev/moq" class="transition-colors hover:text-ink">GitHub</a>
						<a href="https://discord.moq.dev" class="transition-colors hover:text-ink">Discord</a>
						<a href="/rss.xml" class="transition-colors hover:text-ink">RSS</a>
						<a href="https://x.com/kixelated" class="transition-colors hover:text-ink">X</a>
						<a href="https://bsky.app/profile/kixel.me" class="transition-colors hover:text-ink">Bluesky</a>
						<a href="mailto:hello@kixel.us" class="transition-colors hover:text-ink">hello@kixel.us</a>
					</div>
				</div>
			</div>
		</footer>
	</body>
</html>

<script>
	import { isStill, setStill, whileLive } from "@/lib/motion";
	import { renderStats } from "@/stats";

	renderStats();

	// Every motion toggle on the page shows the same state, and a click flips it everywhere.
	const toggles = document.querySelectorAll<HTMLButtonElement>("[data-motion-toggle]");
	const showMotion = () => {
		const still = isStill();
		for (const toggle of toggles) {
			toggle.toggleAttribute("data-still", still);
			toggle.setAttribute("aria-label", still ? "Play motion" : "Pause motion");
		}
	};
	for (const toggle of toggles) toggle.addEventListener("click", () => setStill(!isStill()));
	document.addEventListener("motion", showMotion);
	matchMedia("(prefers-reduced-motion: reduce)").addEventListener("change", showMotion);
	showMotion();

	// The phone menu closes on Escape or a tap anywhere else, like any other drop-down.
	const menu = document.querySelector<HTMLDetailsElement>("[data-menu]");
	if (menu) {
		document.addEventListener("keydown", (e) => {
			if (e.key !== "Escape" || !menu.open) return;
			menu.open = false;
			menu.querySelector("summary")?.focus();
		});
		document.addEventListener("click", (e) => {
			if (menu.open && !menu.contains(e.target as Node)) menu.open = false;
		});
	}

	// CSS loops hold still while their section is offscreen.
	for (const el of document.querySelectorAll("[data-loop]")) {
		whileLive(el, (live) => el.classList.toggle("offscreen", !live));
	}

	// One-shot scroll reveal: `.scribble` underlines draw in as they enter view.
	const reveals = new IntersectionObserver(
		(entries) => {
			for (const entry of entries) {
				if (!entry.isIntersecting) continue;
				entry.target.classList.add("in");
				reveals.unobserve(entry.target);
			}
		},
		{ rootMargin: "0px 0px -8% 0px" },
	);
	for (const el of document.querySelectorAll(".scribble")) reveals.observe(el);
</script>

<style>
	@reference "./global.css";

	.menu summary {
		@apply grid size-9 cursor-pointer list-none place-items-center rounded-lg border border-line-strong bg-surface-2 transition-colors hover:border-ink-3;
	}
	.menu summary::-webkit-details-marker {
		display: none;
	}
	.menu-bars {
		@apply flex w-4 flex-col gap-1;
	}
	.menu-bars i {
		@apply block h-0.5 rounded-full bg-ink-2 transition;
	}
	.menu[open] .menu-bars i:nth-child(1) {
		translate: 0 0.375rem;
		rotate: 45deg;
	}
	.menu[open] .menu-bars i:nth-child(2) {
		opacity: 0;
	}
	.menu[open] .menu-bars i:nth-child(3) {
		translate: 0 -0.375rem;
		rotate: -45deg;
	}
	.menu[open] summary {
		@apply border-accent;
	}
	.menu-panel {
		@apply absolute inset-x-0 top-full flex flex-col gap-1 border-b border-line bg-surface/95 px-5 pb-5 pt-3 backdrop-blur-md;
	}

	/* The cat stands behind the footer's top edge, cropped at the shoulders. */
	.cat {
		@apply pointer-events-none absolute bottom-full right-5 h-20 w-28 overflow-hidden sm:right-[10%] md:h-24 md:w-36;
	}
	.cat img {
		@apply absolute inset-x-0 top-0 w-full;
	}
</style>
