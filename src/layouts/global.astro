---
import "./global.css";

// NOTE: This is magically used as the type for Astro.props
interface Props {
	title: string;
	description: string;
	// The page draws its own layout instead of sitting in the reading column.
	bare?: boolean;

	frontmatter?: {
		title: string;
		date: string;
		description: string;
		author?: string;
		cover?: string;
	};
}

let { title, frontmatter, description, bare } = Astro.props;
if (frontmatter?.title) title = frontmatter.title;
if (frontmatter?.description) description = frontmatter.description;

const siteUrl = Astro.site?.toString().replace(/\/$/, "") ?? "https://moq.dev";
const pageUrl = new URL(Astro.url.pathname, siteUrl).toString();
const fullTitle = title ? `${title} - Media over QUIC` : "Media over QUIC";
const fullDescription = description
	? `Media over QUIC: ${description}`
	: "Media over QUIC is a new live media protocol designed for simplicity and scale. It uses new browser technologies like WebTransport and WebCodecs to deliver media with latency that rivals WebRTC.";
// An SVG cover is served as the PNG that pages/og renders from it.
const cover = frontmatter?.cover?.replace(/^(.*)\.svg$/, "/og$1.png");
const ogImage = new URL(cover ?? "/layout/og.png", siteUrl).toString();

// moq.wtf for staging builds, moq.pro for live (and local dev).
const proUrl = import.meta.env.MODE === "staging" ? "https://moq.wtf" : "https://moq.pro";

const path = Astro.url.pathname;
const nav = [
	{ href: "/demo", word: "Demos" },
	{ href: "/blog", word: "Blog" },
	{ href: "https://doc.moq.dev", word: "Docs" },
	{ href: "/robotics", word: "Robotics" },
];
const date = frontmatter?.date
	? new Date(frontmatter.date).toLocaleDateString("en-US", {
			year: "numeric",
			month: "long",
			day: "numeric",
			timeZone: "UTC",
		})
	: undefined;
---

<!doctype html>
<html lang="en" class="sl-theme-dark">
	<head>
		<meta charset="UTF-8" />
		<meta name="description" content={fullDescription} />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" type="image/svg+xml" href="/layout/favicon.svg" />
		<link rel="icon" type="image/png" href="/layout/favicon.png" />
		<link rel="alternate" type="application/rss+xml" title="moq.dev RSS Feed" href={new URL("rss.xml", Astro.site)} />
		<meta name="generator" content={Astro.generator} />
		<title>{fullTitle}</title>

		<!-- Open Graph -->
		<meta property="og:type" content={frontmatter?.date ? "article" : "website"} />
		<meta property="og:title" content={fullTitle} />
		<meta property="og:description" content={fullDescription} />
		<meta property="og:url" content={pageUrl} />
		<meta property="og:site_name" content="Media over QUIC" />
		<!-- No og:image:width/height: covers live in public/ at whatever size they
		were drawn, so any hardcoded pair is a lie for most pages. Scrapers measure
		the image themselves when the dimensions are absent; when they're present and
		wrong they're believed, and a card claiming to be smaller than Twitter's
		300x157 minimum gets downgraded to a thumbnail. -->
		<meta property="og:image" content={ogImage} />

		<!-- Twitter Card -->
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={fullTitle} />
		<meta name="twitter:description" content={fullDescription} />
		<meta name="twitter:image" content={ogImage} />

		<!-- Theme color -->
		<meta name="theme-color" content="#0f172a" />
	</head>
	<body class="relative flex min-h-screen flex-col">
		<div class="grid-wash" aria-hidden="true"></div>

		<header class="sticky top-0 z-20 border-b border-line bg-bg/85 backdrop-blur-md">
			<div class="mx-auto flex max-w-6xl items-center justify-between gap-4 px-5 py-3 md:px-8">
				<a href="/" class="shrink-0 transition-opacity hover:opacity-85" aria-label="Media over QUIC home">
					<img src="/home/logo.svg" class="-mb-0.5 h-8 w-auto sm:h-9" alt="Media over QUIC" />
				</a>

				<nav class="flex items-center gap-1 text-[0.92rem] font-medium text-ink-2 sm:gap-2">
					{
						nav.map(({ href, word }) => (
							<a
								href={href}
								class:list={[
									"rounded-md px-2.5 py-1.5 transition-colors hover:bg-tint hover:text-ink",
									word === "Robotics" && "hidden md:block",
									(word === "Blog" || word === "Docs") && "hidden sm:block",
									path.startsWith(href) && "text-ink underline decoration-accent decoration-2 underline-offset-[6px]",
								]}
							>
								{word}
							</a>
						))
					}
				</nav>

				<div class="flex items-center gap-3 sm:gap-4">
					<a
						href="https://github.com/moq-dev/moq"
						class="hidden items-center gap-1.5 opacity-90 transition hover:-translate-y-px hover:opacity-100 md:flex"
					>
						<img src="/layout/github-icon.svg" class="h-7 w-auto" alt="GitHub" />
						<span data-stat="stars" data-short class="font-mono text-[0.75rem] font-medium text-accent"></span>
					</a>
					<a
						href="https://discord.moq.dev"
						class="hidden items-center gap-1.5 opacity-90 transition hover:-translate-y-px hover:opacity-100 md:flex"
					>
						<img src="/layout/discord-icon.svg" class="h-7 w-auto" alt="Discord" />
						<span data-stat="chatters" data-short class="font-mono text-[0.75rem] font-medium text-accent"></span>
					</a>
					<a href={proUrl} class="btn-line whitespace-nowrap px-3.5! py-2! text-[0.875rem]!">
						<img src="/layout/pro-icon.svg" class="-my-1 -ml-1 h-5 w-auto" alt="" />
						moq.pro <span class="hidden sm:inline" aria-hidden="true">→</span>
					</a>
				</div>
			</div>
		</header>

		<main class="relative z-1 flex-1 overflow-x-clip">
			{
				bare ? (
					<slot />
				) : (
					<article class="markdown mx-auto max-w-176 px-5 pb-24 pt-14 md:px-0">
						{date && (
							<p class="label mb-3!">
								{date}
								{frontmatter?.author && <> · {frontmatter.author}</>}
							</p>
						)}
						<slot />
					</article>
				)
			}
		</main>

		<footer class="relative z-1 border-t border-line bg-surface">
			<div class="mx-auto grid max-w-6xl gap-10 px-5 py-14 md:grid-cols-[1.4fr_1fr_1fr_1fr] md:px-8">
				<div class="flex flex-col gap-4">
					<img src="/home/logo.svg" class="h-8 w-auto self-start" alt="Media over QUIC" />
					<p class="max-w-xs text-[0.9rem] leading-relaxed text-ink-3">
						Fork it, yoink it, make it your own. Just tell us what you build.
					</p>
				</div>
				<div class="flex flex-col gap-2 text-[0.9rem] text-ink-2">
					<span class="label mb-1">Project</span>
					<a href="/demo" class="transition-colors hover:text-ink">Demos</a>
					<a href="https://doc.moq.dev" class="transition-colors hover:text-ink">Documentation</a>
					<a href="https://github.com/moq-dev/moq" class="transition-colors hover:text-ink">Source code</a>
					<a href="https://datatracker.ietf.org/wg/moq/about/" class="transition-colors hover:text-ink">
						IETF working group
					</a>
				</div>
				<div class="flex flex-col gap-2 text-[0.9rem] text-ink-2">
					<span class="label mb-1">Community</span>
					<a href="/blog" class="transition-colors hover:text-ink">Blog</a>
					<a href="/rss.xml" class="transition-colors hover:text-ink">RSS</a>
					<a href="https://discord.moq.dev" class="transition-colors hover:text-ink">Discord</a>
					<a href="https://x.com/kixelated" class="transition-colors hover:text-ink">X</a>
					<a href="https://bsky.app/profile/kixel.me" class="transition-colors hover:text-ink">Bluesky</a>
				</div>
				<div class="flex flex-col gap-2 text-[0.9rem] text-ink-2">
					<span class="label mb-1">Production</span>
					<a href={proUrl} class="transition-colors hover:text-ink">moq.pro (managed CDN)</a>
					<a href="https://doc.moq.dev/bin/relay/" class="transition-colors hover:text-ink">Self-host moq-relay</a>
					<a href="mailto:me@kixel.me" class="transition-colors hover:text-ink">me@kixel.me</a>
				</div>
			</div>
		</footer>
	</body>
</html>

<script>
	import { renderStats } from "@/stats";

	renderStats();
</script>
