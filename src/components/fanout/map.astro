---
// Full-bleed interactive relay mesh behind the hero section, with a compact HUD
// for switching publish media types and seeing live topology status.
interface Props {
	class?: string;
}
const { class: className } = Astro.props;
---

<div class:list={["fanout-stage", className]} data-fanout>
	<canvas class="fanout-canvas" data-mesh-canvas aria-hidden="true"></canvas>
	<div class="fanout-scrim" aria-hidden="true"></div>

	<div class="fanout-hud-wrap">
		<fieldset class="fanout-hud" data-no-canvas>
			<legend class="sr-only">Interactive mesh controls</legend>
			<div class="fanout-kinds">
				<button type="button" class="kind-pill" data-kind="video" data-active="true" aria-pressed="true">
					<i class="swatch video" aria-hidden="true" />video
				</button>
				<button type="button" class="kind-pill" data-kind="audio" data-active="false" aria-pressed="false">
					<i class="swatch audio" aria-hidden="true" />audio
				</button>
				<button type="button" class="kind-pill" data-kind="data" data-active="false" aria-pressed="false">
					<i class="swatch data" aria-hidden="true" />data
				</button>
			</div>
			<span class="hud-sep" aria-hidden="true">·</span>
			<span class="hud-status" data-mesh-status>9 relays</span>
			<span class="hud-hint hidden sm:inline">click to publish or add · drag nodes · click relay to fail over</span>
		</fieldset>
	</div>
</div>

<script>
	import { mount } from "./map";

	for (const stage of document.querySelectorAll<HTMLElement>("[data-fanout]")) mount(stage);
</script>

<style>
	@reference "../../layouts/global.css";

	.fanout-stage {
		@apply pointer-events-none absolute inset-0 overflow-hidden;
	}

	/* Overhangs the hero by the pointer pan distance so parallax never reveals an edge. */
	.fanout-canvas {
		position: absolute;
		z-index: 0;
		top: -32px;
		left: -32px;
		width: calc(100% + 64px);
		height: calc(100% + 64px);
		will-change: transform;
	}

	/* Asymmetric dark-slate scrim keeps the left hero copy crisp while leaving the right side bright. */
	.fanout-scrim {
		position: absolute;
		z-index: 1;
		inset: 0;
		background:
			radial-gradient(
				ellipse 62% 80% at 26% 48%,
				rgba(15, 23, 42, 0.98) 0%,
				rgba(15, 23, 42, 0.92) 44%,
				rgba(15, 23, 42, 0.45) 70%,
				rgba(15, 23, 42, 0) 94%
			),
			linear-gradient(
				to right,
				rgba(15, 23, 42, 0.9) 0%,
				rgba(15, 23, 42, 0.68) 34%,
				rgba(15, 23, 42, 0) 60%
			),
			linear-gradient(to top, rgba(15, 23, 42, 0.85) 0%, rgba(15, 23, 42, 0) 20%);
	}

	@media (max-width: 900px) {
		.fanout-scrim {
			background: linear-gradient(
				to bottom,
				rgba(15, 23, 42, 0.88) 0%,
				rgba(15, 23, 42, 0.95) 55%,
				rgba(15, 23, 42, 0.65) 100%
			);
		}
	}

	.fanout-hud-wrap {
		@apply pointer-events-none absolute inset-x-0 bottom-4 z-20 mx-auto flex max-w-6xl justify-start px-5 md:justify-end md:px-8;
	}

	.fanout-hud {
		@apply pointer-events-auto inline-flex flex-wrap items-center gap-x-2.5 gap-y-1.5 rounded-full border border-line-strong/80 bg-bg/80 px-3 py-1.5 font-mono text-[0.68rem] text-ink-3 backdrop-blur-md;
	}

	.fanout-kinds {
		@apply inline-flex items-center gap-1;
	}

	.kind-pill {
		@apply inline-flex items-center gap-1.5 rounded-full px-2 py-0.5 uppercase tracking-[0.06em] text-ink-3 transition-colors hover:text-ink;
	}

	.kind-pill[data-active="true"] {
		@apply bg-surface-2 text-ink;
	}

	.swatch {
		@apply inline-block size-2;
	}

	.swatch.video {
		@apply rounded-[2px] bg-accent-ink;
	}

	.swatch.audio {
		@apply rounded-full bg-sky-300;
	}

	.swatch.data {
		@apply rounded-full bg-amber-300;
	}

	.hud-sep {
		@apply text-line-strong;
	}

	.hud-status {
		@apply text-ink-2;
		font-feature-settings: "tnum";
	}

	.hud-status[data-degraded="true"] {
		@apply text-rose-300;
	}

	.hud-hint {
		@apply border-l border-line-strong pl-2.5 text-ink-3;
	}
</style>
