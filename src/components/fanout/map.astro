---
// The hero's live fan-out map. The script in map.ts draws and runs it.
interface Props {
	class?: string;
}
const { class: className } = Astro.props;
---

<figure
	class:list={["fanout", className]}
	data-fanout
	role="img"
	aria-label="Illustration: publishers and viewers connect to their nearest edge relay across a 3-relay mesh. Each frame goes up once to the publisher's edge and is copied across relays to every subscribed viewer."
>
	<svg class="fanout-svg" aria-hidden="true" />
	<figcaption class="fanout-legend" aria-hidden="true">
		<span><i class="key-frame" />video</span>
		<span><i class="key-frame audio" />audio</span>
		<span><i class="key-sub" />message</span>
		<span><img src="/drawn/icon-globe.svg" alt="" />relay</span>
	</figcaption>
</figure>

<script>
	import { mount } from "./map";

	for (const figure of document.querySelectorAll<HTMLElement>("[data-fanout]")) mount(figure);
</script>

<style>
	@reference "../../layouts/global.css";

	.fanout {
		@apply relative w-full flex-col;
	}
	.fanout-svg {
		@apply block w-full overflow-visible;
		aspect-ratio: 16 / 10;
	}
	.fanout-legend {
		@apply label mt-2 flex flex-wrap items-center gap-x-5 gap-y-2 text-[0.68rem] text-ink-3;
	}
	.fanout-legend span {
		@apply flex items-center gap-2;
	}
	.fanout-legend i {
		@apply inline-block size-2 rounded-full;
	}
	.fanout-legend img {
		@apply size-3.5;
	}
	.key-frame {
		@apply rounded-[2px] bg-accent;
	}
	.key-frame.audio {
		@apply rounded-full bg-sky-300;
	}
	.key-sub {
		@apply bg-ink-2;
	}

	/* Everything below is drawn by map.ts, so it's styled globally within the figure.
	   --s is the map's scale (smaller on phones); --c is the color of a broadcast. */
	.fanout :global(.mesh-link) {
		fill: none;
		stroke: var(--color-slate-600);
		stroke-width: calc(2px * var(--s, 1));
		stroke-linecap: round;
	}
	.fanout :global(.access-link) {
		fill: none;
		stroke: var(--color-slate-700);
		stroke-width: calc(1.5px * var(--s, 1));
		stroke-dasharray: 1;
	}
	/* A link lights up in the color of whatever just crossed it, then cools. */
	.fanout :global(.glow-link) {
		fill: none;
		stroke: var(--c);
		stroke-width: calc(3px * var(--s, 1));
		stroke-linecap: round;
		opacity: 0;
		filter: drop-shadow(0 0 4px var(--c));
	}
	.fanout :global(.packet) {
		fill: var(--c);
		stroke: var(--color-slate-950);
		stroke-width: 1.8;
	}
	.fanout :global(.packet-tail) {
		stroke: var(--c);
		stroke-width: calc(3.5px * var(--s, 1));
		stroke-linecap: round;
		opacity: 0.42;
	}
	.fanout :global(.relay-pad),
	.fanout :global(.end-pad) {
		fill: var(--color-bg);
	}
	.fanout :global(.relay-pad) {
		stroke: var(--color-line-strong);
		stroke-width: 1.5;
	}
	.fanout :global(.relay-pulse) {
		fill: none;
		stroke: var(--c, var(--color-accent-ink));
		stroke-width: 2.4;
		opacity: 0;
	}
	/* An endpoint ripples in its color as a frame leaves or lands. */
	.fanout :global(.ripple) {
		fill: none;
		stroke: var(--c);
		stroke-width: 2.2;
		opacity: 0;
	}
	/* A viewer takes the color of what it watches. */
	.fanout :global(.dot) {
		fill: var(--c);
		stroke: var(--color-slate-950);
		stroke-width: 2.2;
	}
</style>
