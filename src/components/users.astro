---
interface Props {
	// Grid columns, since the reading column is too narrow for four across.
	class?: string;
	// Only show users of this use case.
	useCase?: string;
}

const { class: columns = "sm:grid-cols-2", useCase } = Astro.props;

// Companies running MoQ in production. A null `name` renders as a redaction bar
// for users who can't be named yet; `redacted` sets the bar's width.
const users = [
	{
		name: "Meta",
		useCase: "contribution",
		what: "Live ingest",
		body: 'Spoke about "Shipping MoQ for Instagram and Facebook Live Ingest" at DEMOQED. Uses its own implementation of the standard, not ours.',
		links: [{ text: "DEMOQED program", href: "https://moqalliance.org/demoqed-2026/" }],
	},
	{
		name: "Saronic",
		useCase: "robotics",
		what: "Autonomous boats",
		body: "MoQ is the primary video system across its autonomous vessels. Transmits multiple cameras/qualities over Starlink.",
		links: [
			{ text: "Proof that I'm not lying", href: "https://medium.com/saronic-technologies/the-ground-moves-building-on-early-open-source-without-getting-burned-ba2af78beb78" },
			{ text: "Corsair rescues two Army pilots", href: "https://www.navalnews.com/naval-news/2026/06/saronic-usv-rescues-two-u-s-army-pilots-downed-by-iran/" },
		],
	},
	{
		name: "Evolve Robotics",
		useCase: "robotics",
		what: "Teleoperation",
		body: 'Using MoQ extensively for VR teleoperation. Spoke at Demoqed about their usage.',
		links: [{ text: "evolverobotics.com", href: "https://evolverobotics.com/" }],
	},
	{ name: null, useCase: "robotics", redacted: "w-52", what: "Drones", body: "A major government contractor flying drone around with MoQ (cellular). That's all we're allowed to say.", links: [] },
	{ name: null, useCase: "robotics", redacted: "w-44", what: "Drones", body: "Another defense contractor flying drones around, this time with Starlink. The drone controls are also transmitted via MoQ.", links: [] },
];
---

<div class={`not-prose grid gap-5 ${columns}`}>
	{
		users
			.filter((user) => !useCase || user.useCase === useCase)
			.map((user) => (
			<div class="card flex flex-col gap-2 p-5">
				<span class="label">{user.what}</span>
				{user.name ? (
					<h3 class="text-[1.2rem] font-semibold text-white">{user.name}</h3>
				) : (
					<h3 class={`my-0.5 flex h-8 ${user.redacted} -rotate-1 items-center justify-center bg-black font-mono text-base tracking-[0.3em] text-white`}>
						REDACTED
					</h3>
				)}
				<p class="text-[0.9rem] leading-relaxed text-slate-400">{user.body}</p>
				{user.links.length > 0 && (
					<div class="mt-auto flex flex-col gap-1 pt-2 text-[0.9rem]">
						{user.links.map((link) => (
							<a href={link.href} class="green-link">
								{link.text}
							</a>
						))}
					</div>
				)}
			</div>
		))
	}
</div>
