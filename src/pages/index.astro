---
import FanoutMap from "@/components/fanout/map.astro";
import Layout from "@/layouts/global.astro";

interface Post {
	frontmatter: { title: string; description: string; date: string; cover: string };
	url: string;
}

const posts = Object.values(import.meta.glob<Post>("./blog/*.mdx", { eager: true }))
	.sort((a, b) => Date.parse(b.frontmatter.date) - Date.parse(a.frontmatter.date))
	.slice(0, 3);

const formatDate = (date: string) =>
	new Date(date).toLocaleDateString("en-US", { year: "numeric", month: "short", day: "numeric", timeZone: "UTC" });

const proUrl = import.meta.env.MODE === "staging" ? "https://moq.wtf" : "https://moq.pro";

// "Massive scale" has its own section below, so it isn't repeated here.
const features = [
	{ icon: "rocket", title: "Adaptive latency", body: "Keep viewers live through the shittiest network conditions." },
	{ icon: "link", title: "Live discovery", body: "Dynamic announcements, connecting arbitrary publishers to subscribers." },
	{ icon: "battery", title: "On-demand delivery", body: "Encode and send only when someone is watching." },
	{ icon: "globe", title: "Modern web", body: "Publish and play directly in the browser. No need for WebRTC!" },
	{ icon: "lock", title: "Secure", body: "Use TLS, JWTs, and optional end-to-end encryption." },
	{ icon: "back", title: "Works with your tools", body: "Ingest with OBS or FFmpeg; serve HLS and WebRTC players." },
];

const languages = [
	{ name: "Rust", icon: "rust", href: "https://doc.moq.dev/lib/rs/" },
	{ name: "TypeScript", icon: "typescript", href: "https://doc.moq.dev/lib/js/" },
	{ name: "Swift", icon: "swift", href: "https://doc.moq.dev/lib/swift/" },
	{ name: "Kotlin", icon: "kotlin", href: "https://doc.moq.dev/lib/kt/" },
	{ name: "Python", icon: "python", href: "https://doc.moq.dev/lib/py/" },
	{ name: "Go", icon: "go", href: "https://doc.moq.dev/lib/go/" },
	{ name: "Dart", icon: "dart", href: "https://doc.moq.dev/lib/dart/" },
	{ name: "C", icon: "c", href: "https://doc.moq.dev/lib/c/" },
];

// A few members of the MoQ Alliance. `icon` is hand-drawn art in public/icons/alliance/.
const alliance = [
	{ name: "Cloudflare", icon: "cloudflare" },
	{ name: "Akamai", icon: "akamai" },
	{ name: "AWS", icon: "aws" },
	{ name: "Fastly", icon: "fastly" },
	{ name: "Cisco", icon: "cisco" },
	{ name: "Intel", icon: "intel" },
	{ name: "Oracle", icon: "oracle" },
	{ name: "Mux", icon: "mux" },
];

// `icon` is hand-drawn art in public/icons/use-case/.
const useCases = [
	{ title: "Robotics", icon: "robotics", body: "Real-time teleoperation, with telemetry and control on the same relays as the video.", href: "/robotics" },
	{ title: "Voice and video AI", icon: "voice-video-ai", body: "Server-side media in Rust or Python, played back faster than real time in the browser.", href: "https://doc.moq.dev/concept/use-case/ai" },
	{ title: "Interactive", icon: "interactive", body: "Media down, input up. MoQ Boy is a Game Boy played by everyone watching at once.", href: "/boy" },
	{ title: "Conferencing", icon: "conferencing", body: "Browser publish and watch with a live roster, plus WebRTC for WHIP and WHEP clients.", href: "/blog/first-app" },
	{ title: "Distribution", icon: "distribution", body: "Fan out to millions of viewers on demand, and keep legacy players on HLS.", href: "/blog/replacing-hls-dash" },
	{ title: "Contribution", icon: "contribution", body: "Ingest from OBS, FFmpeg, or SRT with dynamic origins and failover.", href: "https://doc.moq.dev/bin/obs" },
];

// The news crawl: real news only.
const ticker = [
	...posts.map((post) => ({ tag: "New post", text: post.frontmatter.title, href: post.url })),
	{ tag: "moq.pro", text: "400 GB of delivery free every month", href: proUrl },
	{ tag: "IETF", text: "MoQ is being standardized by the IETF as a new RFC", href: "https://datatracker.ietf.org/wg/moq/about/" },
];

// The cat crowds from the moq.pro launch post, one order of magnitude at a time.
const fanout = [
	{ n: 1, label: "×1" },
	{ n: 10, label: "×10" },
	{ n: 100, label: "×100" },
	{ n: 1000, label: "×1,000" },
];
---

<Layout title="" description="" bare>
	<!-- News crawl. The second copy makes the loop seamless and is hidden from assistive tech. -->
	<div class="ticker" data-loop>
		<span class="ticker-bug"><span class="ticker-dot" aria-hidden="true"></span>Live</span>
		<div class="ticker-window">
			<div class="ticker-track">
				{
					[false, true].map((copy) => (
						<ul aria-hidden={copy ? "true" : undefined}>
							{ticker.map((item) => (
								<li>
									<a href={item.href} tabindex={copy ? -1 : undefined}>
										<span class="ticker-tag">{item.tag}</span>
										{item.text}
									</a>
								</li>
							))}
						</ul>
					))
				}
			</div>
		</div>
	</div>

	<!-- Hero -->
	<section class="wrap grid items-center gap-8 pb-10 pt-10 md:pt-14 lg:grid-cols-[minmax(0,1fr)_minmax(0,1.1fr)] lg:gap-12 lg:pb-16 lg:pt-16">
		<div>
			<a href="/robotics" class="pill group">
				<span class="pill-tag">In prod</span>
				<span>Saronic ships MoQ on its autonomous boats</span>
				<span class="text-slate-500 transition-transform group-hover:translate-x-0.5" aria-hidden="true">→</span>
			</a>

			<h1 class="display mt-8 text-[clamp(3rem,10.5vw,5.6rem)] lg:text-[clamp(3.6rem,5.6vw,5.6rem)]">
				Real-time media <span class="whitespace-nowrap">and <span class="scribble">massive scale.</span></span>
			</h1>

			<p class="mt-8 max-w-xl text-[1.15rem] leading-relaxed text-slate-300 text-pretty md:text-[1.3rem]">
				The <strong class="font-semibold text-white">open standard</strong> for streaming live video, audio, and <em>whatever you want</em>.
			</p>

			<div class="mt-9 flex flex-wrap items-center gap-4">
				<a href="/demo" class="btn-green">Demos <span aria-hidden="true">→</span></a>
				<a href="https://doc.moq.dev" class="btn-line">Docs</a>
			</div>
		</div>

		<FanoutMap />
	</section>

	<!-- Fan-out: one order of magnitude at a time. -->
	<section class="wrap section">
		<div class="section-head">
			<h2 class="section-title">Massive <span class="scribble scribble-2">scale.</span></h2>
			<p class="section-lede">Fan out horizontally through CDNs, from one user to millions.</p>
		</div>
		<ol class="steps" data-loop>
			{
				fanout.map((step, i) => (
					<li class="step reveal" style={`--i:${i}`}>
						<span class="step-label">{step.label}</span>
						<img src={`/blog/open-for-business/viewers-${step.n}.svg`} class="step-art boil-always" style={`--i:${i}`} alt="" loading="lazy" />
						{i < fanout.length - 1 && <img src="/drawn/arrow-6.svg" class="step-arrow" alt="" />}
					</li>
				))
			}
		</ol>
	</section>

	<!-- Features -->
	<section class="wrap section">
		<h2 class="sr-only">What you get</h2>
		<img src="/drawn/what.svg" class="mb-6 w-36 -rotate-1 md:w-40" alt="" />
		<ul class="features">
			{
				features.map((feature) => (
					<li class="feature group">
						<span class="icon-tile size-14">
							<img src={`/drawn/icon-${feature.icon}.svg`} class="boil size-8 object-contain" alt="" />
						</span>
						<span class="flex flex-col gap-1.5">
							<h3 class="feature-title">{feature.title}</h3>
							<p class="text-[1rem] leading-relaxed text-slate-400 text-pretty">{feature.body}</p>
						</span>
					</li>
				))
			}
			<li class="feature group sm:col-span-2 lg:col-span-3">
				<span class="icon-tile size-14">
					<img src="/drawn/icon-puzzle.svg" class="boil size-8 object-contain" alt="" />
				</span>
				<span class="flex flex-col gap-1.5">
					<h3 class="feature-title">Every platform</h3>
					<p class="text-[1rem] leading-relaxed text-slate-400">Build with Rust, TypeScript, and native bindings.</p>
					<span class="mt-3 flex flex-wrap gap-2">
						{
							languages.map((language) => (
								<a href={language.href} class="chip group">
									<img src={`/icons/cards/${language.icon}.svg`} class="boil h-6 w-6 object-contain" alt="" />
									{language.name}
								</a>
							))
						}
					</span>
				</span>
			</li>
		</ul>
	</section>

	<!-- Standards -->
	<section class="mt-24 border-y-2 border-slate-950 bg-slate-950/40 md:mt-32">
		<div class="wrap flex flex-col items-start gap-6 py-9 md:flex-row md:items-center md:gap-12">
			<div class="flex shrink-0 items-center gap-6">
				<img src="/home/ietf.svg" class="h-11 w-auto" alt="IETF" />
				<img src="/home/quic.svg" class="h-7 w-auto" alt="QUIC" />
			</div>
			<p class="max-w-4xl text-[1.02rem] leading-relaxed text-slate-400 text-pretty">
				<strong class="font-semibold text-white">Build first, argue later.</strong>{" "}
				MoQ is being standardized by the <a class="green-link" href="https://datatracker.ietf.org/wg/moq/about/">IETF</a>{" "}
				as a new RFC. We ship{" "}
				<a class="green-link" href="https://doc.moq.dev/concept/layer/moq-lite">moq-lite</a> today: a forwards-compatible
				subset of <a class="green-link" href="https://datatracker.ietf.org/doc/draft-ietf-moq-transport/">moq-transport</a>{" "}
				that works with any MoQ CDN.
			</p>
		</div>
	</section>

	<!-- Use cases, one ruled line each. -->
	<section class="wrap section">
		<h2 class="quiet-title mb-10 md:mb-12">More than <span class="scribble scribble-2">media.</span></h2>
		<ul class="channels">
			{
				useCases.map((useCase) => (
					<li>
						<a href={useCase.href} class="channel group">
							<img src={`/icons/use-case/${useCase.icon}.svg`} class="channel-art boil" alt="" />
							<span class="flex flex-col gap-1.5">
								<span class="channel-title">
									{useCase.title}
									<span class="channel-arrow" aria-hidden="true">→</span>
								</span>
								<span class="text-[0.98rem] leading-relaxed text-slate-400 text-pretty">{useCase.body}</span>
							</span>
						</a>
					</li>
				))
			}
		</ul>
	</section>

	<!-- Alliance -->
	<section class="section-band">
		<div class="wrap">
			<h2 class="quiet-title">The MoQ <span class="scribble">Alliance.</span></h2>
			<p class="mt-6 max-w-2xl text-[1.12rem] leading-relaxed text-slate-300 text-pretty">
				The <a class="green-link" href="https://moqalliance.org/">MoQ Alliance</a> is a group of CDNs, vendors, and open
				source projects building MoQ together, with independent implementations that interoperate.
			</p>
			<ul class="stickers">
				{
					alliance.map((member) => (
						<li class="sticker">
							<img src={`/icons/alliance/${member.icon}.svg`} class="h-10 w-full max-w-20 object-contain" alt="" />
							<span>{member.name}</span>
						</li>
					))
				}
				<li class="contents">
					<a href="https://moqalliance.org/" class="sticker sticker-more group">
						<span class="font-display text-[1.05rem] font-bold leading-tight text-white group-hover:text-green-500">and many more</span>
						<span class="text-green-500 transition-transform group-hover:translate-x-0.5" aria-hidden="true">→</span>
					</a>
				</li>
			</ul>
		</div>
	</section>

	<!-- Production -->
	<section class="wrap section">
		<div class="relative max-w-2xl">
			<h2 class="quiet-title">Ready for <span class="scribble scribble-3">production.</span></h2>
			<p class="section-lede mt-6 max-w-xl!">Every piece is open source under MIT or Apache 2.0. Run it yourself, or let us run it for you.</p>
		</div>
		<div class="mt-20 grid gap-20 md:grid-cols-2 md:gap-8">
			<div class="plan reveal">
				<span class="label">Open source</span>
				<h3 class="plan-title">Self-host</h3>
				<p class="plan-body">
					Deploy <code class="font-mono text-[0.88em] text-slate-200">moq-relay</code> anywhere. Clusters discover each
					other, route by the shortest path, and fail over without a central controller.
				</p>
				<ul class="plan-list">
					<li>No license fees, no lock-in</li>
					<li>Compatible with any MoQ CDN</li>
					<li>Community support on Discord</li>
				</ul>
				<div class="mt-auto flex flex-wrap gap-3 pt-8">
					<a href="https://doc.moq.dev/bin/relay/" class="btn-line">Relay docs</a>
					<a href="https://github.com/moq-dev/moq" class="btn-line">GitHub</a>
				</div>
			</div>
			<div class="plan plan-pro reveal" style="--i:1">
				<img src="/drawn/open.svg" class="open-note" alt="open and optional" />
				<span class="label text-green-500!">Managed</span>
				<h3 class="plan-title flex items-center gap-3">
					moq.pro
					<img src="/layout/pro-icon.svg" class="h-8" alt="" />
				</h3>
				<p class="plan-body">
					A global MoQ CDN run by the people who wrote the relay. Every viewer lands on the nearest edge, with no regions
					to pick.
				</p>
				<ul class="plan-list">
					<li>400 GB of delivery free every month</li>
					<li>Up and running in minutes, nothing to operate</li>
					<li>Direct support from the maintainers</li>
				</ul>
				<div class="mt-auto flex flex-wrap gap-3 pt-8">
					<a href={proUrl} class="btn-green">Get started <span aria-hidden="true">→</span></a>
					<a href="mailto:me@kixel.me" class="btn-line">Talk to us</a>
				</div>
			</div>
		</div>
	</section>

	<!-- Blog -->
	<section class="wrap section">
		<div class="mb-10 flex items-end justify-between gap-6 md:mb-12">
			<h2 class="quiet-title">From the <span class="scribble">blog.</span></h2>
			<a href="/blog" class="green-link shrink-0 font-display text-[1.1rem] font-bold">All posts <span aria-hidden="true">→</span></a>
		</div>
		<div class="grid gap-7 md:grid-cols-3">
			{
				posts.map((post) => (
					<a href={post.url} class="polaroid group">
						<img src={post.frontmatter.cover} class="mb-2 aspect-video w-full rounded-lg bg-slate-900 object-cover" alt="" loading="lazy" />
						<span class="label px-1">{formatDate(post.frontmatter.date)}</span>
						<span class="px-1 font-display text-[1.35rem] font-bold leading-[1.12] tracking-[-0.01em] text-white text-balance group-hover:text-green-500">
							{post.frontmatter.title}
						</span>
						<span class="px-1 text-[0.95rem] leading-relaxed text-slate-400 text-pretty">{post.frontmatter.description}</span>
					</a>
				))
			}
		</div>
	</section>
</Layout>

<style>
	@reference "../layouts/global.css";

	.section {
		@apply pt-24 md:pt-32;
	}
	.section-head {
		@apply mb-10 flex flex-col gap-5 md:mb-14 lg:flex-row lg:items-end lg:justify-between lg:gap-14;
	}
	.section-title {
		@apply display text-[clamp(2.8rem,6.2vw,5.4rem)];
	}
	.quiet-title {
		@apply display text-[clamp(2.3rem,4.2vw,3.4rem)] leading-[0.98];
	}
	.section-lede {
		@apply max-w-md text-[1.12rem] leading-relaxed text-slate-400 text-pretty lg:pb-2;
	}

	.pill {
		@apply inline-flex items-center gap-3 rounded-full border-2 border-slate-700 bg-slate-800/60 py-1.5 pl-1.5 pr-4 text-[0.9rem] text-slate-300 transition-colors hover:border-green-500 hover:text-white;
	}
	.pill-tag {
		@apply shrink-0 whitespace-nowrap rounded-full bg-green-500 px-2.5 py-0.5 font-mono text-[0.68rem] font-semibold uppercase tracking-wider text-slate-950;
	}

	.ticker {
		@apply flex items-stretch border-b-2 border-slate-950 bg-green-500 text-slate-950;
	}
	.ticker-bug {
		@apply z-10 flex shrink-0 items-center gap-2 bg-slate-950 px-3 font-display text-[0.85rem] font-extrabold uppercase tracking-[0.14em] text-white sm:px-4;
	}
	.ticker-dot {
		@apply size-2 rounded-full bg-green-500;
	}
	.ticker-window {
		overflow: hidden;
		flex: 1;

		@variant still {
			overflow-x: auto;
			scrollbar-width: none;
		}
	}
	.ticker-track {
		display: flex;
		width: max-content;
		animation: crawl 52s linear infinite;

		@variant still {
			animation: none;
		}
	}
	.ticker:hover .ticker-track,
	.ticker:focus-within .ticker-track {
		animation-play-state: paused;
	}
	.ticker ul {
		display: flex;
	}
	.ticker li {
		display: flex;
		align-items: center;
	}
	.ticker li::after {
		content: "///";
		@apply px-5 font-mono text-[0.8rem] font-semibold text-slate-950/40;
	}
	.ticker a {
		@apply flex items-center gap-2 whitespace-nowrap py-2 font-display text-[0.95rem] font-bold hover:underline;
	}
	.ticker-tag {
		@apply rounded-sm bg-slate-950/15 px-1.5 py-0.5 font-mono text-[0.68rem] font-semibold uppercase tracking-[0.08em];
	}

	/* The track holds two identical halves, so sliding exactly one half loops seamlessly. */
	@keyframes crawl {
		to {
			translate: -50% 0;
		}
	}

	/* The fan-out steps: the crowd grows by ten each card. */
	.steps {
		@apply grid grid-cols-2 gap-4 sm:gap-5 lg:grid-cols-4 lg:gap-10;
	}
	.step {
		@apply card relative flex flex-col p-4 sm:p-5;
	}
	.step-label {
		@apply display text-[2.4rem] text-green-500 tabular-nums sm:text-[3.2rem] lg:text-[3.6rem];
	}
	.step-art {
		@apply -mb-2 aspect-square w-full;
	}
	.step-arrow {
		@apply pointer-events-none absolute -right-11 top-[46%] z-10 hidden w-12 lg:block;
	}

	/* What you get: ruled cells, a drawing and a claim each. */
	.features {
		@apply grid border-t-2 border-slate-700 sm:grid-cols-2 sm:gap-x-10 lg:grid-cols-3;
	}
	.feature {
		@apply flex items-start gap-5 border-b-2 border-slate-800 py-7;
	}
	.feature-title {
		@apply font-display text-[1.35rem] font-bold leading-tight tracking-[-0.01em] text-white;
	}

	/* Use cases: ruled lines, one each, with its drawing in the margin. */
	.channels {
		@apply grid border-t-2 border-slate-700 sm:grid-cols-2 sm:gap-x-10 lg:grid-cols-3;
	}
	.channels > li {
		@apply border-b-2 border-slate-800;
	}
	.channel {
		@apply flex h-full items-start gap-5 py-7 pr-2 md:py-8;
	}
	.channel-art {
		@apply mt-1 h-12 w-12 shrink-0 object-contain transition-transform duration-200 group-hover:scale-110 group-hover:-rotate-1 md:h-14 md:w-14;
	}
	.channel-title {
		@apply flex items-center gap-2 font-display text-[1.4rem] font-bold leading-tight tracking-[-0.01em] text-white group-hover:text-green-500;
	}
	.channel-arrow {
		@apply -translate-x-1 opacity-0 transition group-hover:translate-x-0 group-hover:opacity-100 group-focus-visible:opacity-100;
	}

	.section-band {
		@apply mt-24 border-y-2 border-slate-950 bg-slate-950/50 py-20 md:mt-32 md:py-24;
	}
	.stickers {
		@apply mt-12 grid grid-cols-3 gap-3 sm:grid-cols-5 sm:gap-4 lg:grid-cols-9;
	}
	.sticker {
		@apply flex flex-col items-center justify-center gap-3 rounded-2xl border-2 border-slate-700 bg-slate-900 px-2 py-5 text-[0.85rem] font-medium text-slate-300 sm:text-[0.9rem];
		box-shadow: 5px 5px 0 0 var(--color-slate-950);
	}
	.sticker-more {
		@apply gap-1 border-dashed text-center transition-colors hover:border-green-500;
	}

	.open-note {
		/* Pinned above the card, not on its border. */
		@apply pointer-events-none absolute bottom-full right-6 mb-2 w-40 rotate-1 md:w-48;
	}
	.plan {
		@apply card relative flex flex-col bg-slate-900 p-7 md:p-10;
	}
	.plan-pro {
		@apply border-green-500;
		box-shadow: 8px 8px 0 0 var(--color-green-500);
	}
	.plan-title {
		@apply mt-2 font-display text-[2.1rem] font-extrabold leading-tight tracking-[-0.015em] text-white;
	}
	.plan-body {
		@apply mt-3 max-w-md leading-relaxed text-slate-400;
	}
	.plan-list {
		@apply mt-6 flex flex-col gap-2.5 text-[0.98rem] text-slate-300;
	}
	.plan-list li {
		@apply flex gap-3;
	}
	.plan-list li::before {
		content: "✓";
		@apply font-bold text-green-500;
	}
</style>
