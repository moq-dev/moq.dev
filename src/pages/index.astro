---
import FanoutMap from "@/components/fanout/map.astro";
import Cat from "@/components/voice/cat";
import Layout from "@/layouts/global.astro";

interface Post {
	frontmatter: { title: string; description: string; date: string; cover: string };
	url: string;
}

const posts = Object.values(import.meta.glob<Post>("./blog/*.mdx", { eager: true }))
	.sort((a, b) => Date.parse(b.frontmatter.date) - Date.parse(a.frontmatter.date))
	.slice(0, 5);

const [leadPost, ...recentPosts] = posts;

const formatDate = (date: string) =>
	new Date(date).toLocaleDateString("en-US", { year: "numeric", month: "short", day: "numeric", timeZone: "UTC" });

const proUrl = import.meta.env.MODE === "staging" ? "https://moq.wtf" : "https://moq.pro";

const demos = [
	{
		title: "MoQ Boy",
		icon: "/demo/moqboy.svg",
		body: "Multiplayer Game Boy emulation on a remote server, using MoQ tracks for everything.",
		href: "/boy",
	},
	{
		title: "CARLA",
		icon: "/demo/carla.svg",
		body: "Steer simulated vehicles over MoQ. Cameras on demand, controls and telemetry on one link.",
		href: "/carla",
	},
	{
		title: "Voice AI",
		cat: true,
		body: "Talk to a Pipecat voice agent over MoQ. Faster-than-real-time reply and instant barge-in.",
		href: "/voice",
	},
	{
		title: "Big Buck Bunny",
		icon: "/demo/bunny.svg",
		body: "Watch a live broadcast via the <moq-watch> web component or tree-shakable JS library.",
		href: "/watch?project=demo&name=bbb.hang",
	},
	{
		title: "hang.live",
		icon: "/hang.svg",
		body: "A full conferencing app built on MoQ with WebGL rendering, spatial audio, and markdown chat.",
		href: "https://hang.live",
		external: true,
	},
	{
		title: "Publish",
		icon: "/icons/use-case/contribution.svg",
		body: "Go live from your browser—share your camera, mic, or screen with a private watch link.",
		href: "/publish",
	},
];

const features = [
	{ icon: "rocket", title: "Adaptive latency", body: "Keep viewers live through the shittiest network conditions." },
	{ icon: "stonk", title: "Massive scale", body: "Fan out horizontally through CDNs, from one user to millions." },
	{ icon: "link", title: "Live discovery", body: "Dynamic announcements, connecting arbitrary publishers to subscribers." },
	{ icon: "battery", title: "On-demand delivery", body: "Encode and send only when someone is watching." },
	{ icon: "globe", title: "Modern web", body: "Publish and play directly in the browser. No need for WebRTC!" },
	{ icon: "puzzle", title: "Every platform", body: "Build with Rust, TypeScript, and native bindings." },
	{ icon: "lock", title: "Secure", body: "Use TLS, JWTs, and optional end-to-end encryption." },
	{ icon: "back", title: "Works with your tools", body: "Ingest with OBS or FFmpeg; serve HLS and WebRTC players." },
];

const languages = [
	{ name: "Rust", icon: "rust", href: "https://doc.moq.dev/lib/rs/" },
	{ name: "TypeScript", icon: "typescript", href: "https://doc.moq.dev/lib/js/" },
	{ name: "Swift", icon: "swift", href: "https://doc.moq.dev/lib/swift/" },
	{ name: "Kotlin", icon: "kotlin", href: "https://doc.moq.dev/lib/kt/" },
	{ name: "Python", icon: "python", href: "https://doc.moq.dev/lib/py/" },
	{ name: "Go", icon: "go", href: "https://doc.moq.dev/lib/go/" },
	{ name: "Dart", icon: "dart", href: "https://doc.moq.dev/lib/dart/" },
	{ name: "C", icon: "c", href: "https://doc.moq.dev/lib/c/" },
];

// A few members of the MoQ Alliance. `icon` is hand-drawn art in public/icons/alliance/.
const alliance = [
	{ name: "Cloudflare", icon: "cloudflare" },
	{ name: "Akamai", icon: "akamai" },
	{ name: "AWS", icon: "aws" },
	{ name: "Fastly", icon: "fastly" },
	{ name: "Cisco", icon: "cisco" },
	{ name: "Intel", icon: "intel" },
	{ name: "Oracle", icon: "oracle" },
	{ name: "Mux", icon: "mux" },
];

// `icon` is hand-drawn art in public/icons/use-case/.
const useCases = [
	{
		title: "Robotics",
		icon: "robotics",
		body: "Real-time teleoperation, with telemetry and control on the same relays as the video.",
		href: "/robotics",
	},
	{
		title: "Distribution",
		icon: "distribution",
		body: "Fan out to millions of viewers on demand, and keep legacy players on HLS.",
		href: "/distribution",
	},
	{
		title: "Contribution",
		icon: "contribution",
		body: "Ingest from OBS, FFmpeg, or SRT with dynamic origins and failover.",
		href: "/contribution",
	},
	{
		title: "Voice and video AI",
		icon: "voice-video-ai",
		body: "Server-side media in Rust or Python, played back faster than real time in the browser.",
		href: "/ai",
	},
	{
		title: "Interactive",
		icon: "interactive",
		body: "Media down, input up. MoQ Boy is a Game Boy played by everyone watching at once.",
		href: "/interactive",
	},
	{
		title: "Conferencing",
		icon: "conferencing",
		body: "Browser publish and watch with a live roster, plus WebRTC for WHIP and WHEP clients.",
		href: "/conferencing",
	},
];
---

<Layout title="" description="" bare>
	<!-- Hero -->
	<section class="relative overflow-hidden">
		<div class="grid-wash" aria-hidden="true"></div>
		<div class="hero-glow" aria-hidden="true"></div>
		<div class="relative mx-auto grid max-w-6xl items-center gap-10 px-5 pb-14 pt-12 md:px-8 lg:grid-cols-[minmax(0,1.08fr)_minmax(0,0.92fr)] lg:gap-12 lg:pb-18 lg:pt-16">
			<div class="min-w-0">
				<a
					href="/robotics"
					class="group mb-6 inline-flex flex-wrap items-center gap-x-2.5 gap-y-1 text-[0.875rem] text-ink-2 transition-colors hover:text-ink"
				>
					<span class="shrink-0 rounded-full bg-accent-soft px-2.5 py-0.5 font-mono text-[0.7rem] font-medium uppercase tracking-wider text-accent-ink">
						In prod
					</span>
					<span>Saronic ships MoQ on its autonomous boats</span>
					<span class="text-ink-3 transition-transform group-hover:translate-x-0.5" aria-hidden="true">→</span>
				</a>

				<h1 class="display text-[2.25rem] sm:text-[3.5rem] lg:text-[3.85rem]">
					Real-time media <span class="whitespace-nowrap">and <span class="scribble">massive scale.</span></span>
				</h1>

				<p class="mt-6 max-w-xl text-[1.1rem] leading-relaxed text-ink-2 md:text-[1.22rem]">
					The <strong class="font-semibold text-ink">open standard</strong> for streaming live video, audio, and <em>whatever you want</em>.
				</p>

				<div class="mt-8 flex flex-wrap items-center gap-3">
					<a href="/demo" class="btn-green">Demos <span aria-hidden="true">→</span></a>
					<a href="https://doc.moq.dev" class="btn-line">Docs</a>
					<a href="/blog" class="btn-line">Blog</a>
				</div>
			</div>

			<!-- Live relay fan-out map (md+) floating directly on the grid wash, paired with the player snippet. -->
			<div class="mx-auto flex w-full min-w-0 max-w-lg flex-col gap-4">
				<FanoutMap class="hidden md:flex" />

				<a
					href="/watch?project=demo&name=bbb.hang"
					class="flex items-center justify-between gap-3 rounded-lg border border-line bg-[#020617]/75 px-3.5 py-2.5 text-[0.78rem] transition-colors hover:border-line-strong"
					style="font-family: var(--font-code);"
				>
					<span class="truncate text-ink-2">
						<span class="text-slate-500">&lt;</span><span class="text-accent-ink">moq-watch</span>{" "}
						<span class="text-[#c4b5fd]">url</span>=<span class="text-[#fde68a]">"https://cdn.moq.pro/demo/bbb.hang"</span><span class="text-slate-500">&gt;</span>
					</span>
					<span class="shrink-0 font-mono text-[0.7rem] text-accent-ink">live →</span>
				</a>
			</div>
		</div>
	</section>

	<!-- Demos: ruled 2-column editorial list on a solid surface band (no grid) -->
	<section class="sec-band">
		<div class="mx-auto max-w-6xl px-5 py-14 md:px-8 md:py-16">
			<div class="mb-7 flex items-end justify-between gap-6">
				<div>
					<img src="/drawn/how.svg" class="mb-1.5 h-7 w-auto -rotate-2" alt="" />
					<h2 class="display text-[1.9rem] md:text-[2.3rem]">Demos</h2>
				</div>
				<a href="/demo" class="green-link shrink-0 text-[0.92rem] font-medium">All demos &amp; CLI →</a>
			</div>

			<div class="grid border-t border-line md:grid-cols-2">
				{
					demos.map((demo, i) => (
						<a
							href={demo.href}
							target={demo.external ? "_blank" : undefined}
							rel={demo.external ? "noreferrer" : undefined}
							class:list={[
								"group grid grid-cols-[5rem_1fr_1.25rem] items-center gap-4 border-b border-line py-5 transition-colors hover:bg-tint sm:gap-5",
								i % 2 === 0 ? "md:border-r md:pr-7 md:pl-2" : "md:pl-7 md:pr-2",
							]}
						>
							{demo.cat ? (
								<div class="flex justify-center">
									<Cat client:visible babble class="h-14 w-14" />
								</div>
							) : (
								<img src={demo.icon} class="boil mx-auto h-14 w-20 object-contain" alt="" />
							)}
							<div>
								<h3 class="text-[1.05rem] font-semibold text-ink transition-colors group-hover:text-accent-ink">
									{demo.title}
								</h3>
								<p class="mt-1 text-[0.88rem] leading-relaxed text-ink-3">{demo.body}</p>
							</div>
							<span class="font-mono text-sm text-accent transition-transform group-hover:translate-x-0.5" aria-hidden="true">
								→
							</span>
						</a>
					))
				}
			</div>

			<div class="mt-4 flex flex-wrap items-center justify-between gap-3 text-[0.85rem] text-ink-3">
				<div class="flex flex-wrap items-center gap-x-3 gap-y-1">
					<span>Also:</span>
					<a href="/demo#cli" class="text-ink-2 transition-colors hover:text-accent-ink">MoQ CLI</a>
					<span aria-hidden="true">·</span>
					<a href="/demo#ffmpeg" class="text-ink-2 transition-colors hover:text-accent-ink">FFmpeg</a>
					<span aria-hidden="true">·</span>
					<a href="/demo#gstreamer" class="text-ink-2 transition-colors hover:text-accent-ink">GStreamer</a>
				</div>
				<span class="label">all open source</span>
			</div>
		</div>
	</section>

	<!-- Features + Libraries -->
	<section>
		<div class="mx-auto max-w-6xl px-5 py-14 md:px-8 md:py-16">
			<div class="grid gap-10 lg:grid-cols-[200px_1fr] lg:gap-14">
				<div>
					<h2 class="sr-only">What you get</h2>
					<img src="/drawn/what.svg" class="w-36 -rotate-2" alt="" />
					<p class="mt-4 text-[0.9rem] leading-relaxed text-ink-3">
						Open source under MIT / Apache 2.0.
					</p>
				</div>

				<div class="grid gap-x-10 gap-y-7 sm:grid-cols-2">
					{
						features.map((feature) => (
							<div class="group flex items-start gap-4">
								<img
									src={`/drawn/icon-${feature.icon}.svg`}
									class="boil mt-0.5 h-7 w-7 shrink-0 object-contain"
									alt=""
								/>
								<div>
									<h3 class="font-semibold text-ink">{feature.title}</h3>
									<p class="mt-1 text-[0.9rem] leading-relaxed text-ink-3">{feature.body}</p>
								</div>
							</div>
						))
					}
				</div>
			</div>

			<div class="mt-12 flex flex-col gap-4 border-t border-line pt-8 sm:flex-row sm:items-center sm:justify-between">
				<h3 class="label shrink-0">Libraries</h3>
				<div class="flex flex-wrap items-center gap-x-6 gap-y-3">
					{
						languages.map((language) => (
							<a
								href={language.href}
								class="group inline-flex items-center gap-2 text-[0.92rem] text-ink-2 transition-colors hover:text-ink"
							>
								<img
									src={`/icons/cards/${language.icon}.svg`}
									class="boil h-6 w-6 object-contain"
									alt=""
								/>
								<span>{language.name}</span>
							</a>
						))
					}
				</div>
			</div>
		</div>
	</section>

	<!-- Standards & MoQ Alliance -->
	<section class="sec-band">
		<div class="mx-auto max-w-6xl px-5 py-8 md:px-8 md:py-9">
			<div class="flex flex-col items-start gap-6 md:flex-row md:items-center md:gap-10">
				<div class="flex shrink-0 items-center gap-6">
					<img src="/home/ietf.svg" class="h-10 w-auto" alt="IETF" />
					<img src="/home/quic.svg" class="h-6 w-auto" alt="QUIC" />
				</div>
				<p class="text-[0.98rem] leading-relaxed text-ink-3">
					<strong class="font-semibold text-ink">Build first, argue later.</strong>{" "}
					MoQ is being standardized by the <a class="green-link" href="https://datatracker.ietf.org/wg/moq/about/">IETF</a>{" "}
					as a new RFC. We ship{" "}
					<a class="green-link" href="https://doc.moq.dev/concept/layer/moq-lite">moq-lite</a> today: a forwards-compatible
					subset of <a class="green-link" href="https://datatracker.ietf.org/doc/draft-ietf-moq-transport/">moq-transport</a>{" "}
					that works with any MoQ CDN.
				</p>
			</div>

			<div class="mt-7 flex flex-col gap-5 border-t border-line pt-6 sm:flex-row sm:items-center sm:justify-between">
				<span class="label shrink-0">MoQ Alliance</span>
				<div class="flex flex-wrap items-center gap-x-7 gap-y-4">
					{
						alliance.map((member) => (
							<div class="flex flex-col items-center gap-1.5">
								<img
									src={`/icons/alliance/${member.icon}.svg`}
									class="h-7 w-auto max-w-18 object-contain opacity-90 transition-opacity hover:opacity-100"
									alt=""
								/>
								<span class="text-[0.75rem] leading-none text-ink-3">{member.name}</span>
							</div>
						))
					}
				</div>
				<a href="https://moqalliance.org/" class="green-link shrink-0 text-[0.88rem] font-medium">
					and many more →
				</a>
			</div>
		</div>
	</section>

	<!-- Use cases (ruled index) -->
	<section id="use-cases" class="mx-auto max-w-6xl scroll-mt-20 px-5 py-14 md:px-8 md:py-16">
		<div class="mb-7 flex items-baseline justify-between gap-6">
			<h2 class="display text-[1.9rem] md:text-[2.3rem]">Use cases</h2>
		</div>

		<div class="border-t border-line">
			{
				useCases.map((useCase) => (
					<a
						href={useCase.href}
						class="group grid grid-cols-[2.25rem_1fr_1.25rem] items-center gap-x-4 gap-y-1 border-b border-line px-2 py-4 transition-colors hover:bg-tint sm:grid-cols-[2.5rem_11.5rem_1fr_1.5rem]"
					>
						<img
							src={`/icons/use-case/${useCase.icon}.svg`}
							class="boil h-7 w-8 object-contain"
							alt=""
						/>
						<span class="font-semibold text-ink transition-colors group-hover:text-accent-ink">
							{useCase.title}
						</span>
						<span class="col-start-2 text-[0.9rem] leading-relaxed text-ink-3 sm:col-start-auto">
							{useCase.body}
						</span>
						<span
							class="col-start-3 row-start-1 text-right font-mono text-sm text-accent transition-transform group-hover:translate-x-0.5 sm:col-start-auto sm:row-start-auto"
							aria-hidden="true"
						>
							→
						</span>
					</a>
				))
			}
		</div>
	</section>

	<!-- Blog: solid dark panels floating over a subtle grid wash on a surface band, with cover art on every post -->
	<section class="sec-band relative overflow-hidden">
		<div class="grid-wash" aria-hidden="true"></div>
		<div class="relative mx-auto max-w-6xl px-5 py-14 md:px-8 md:py-16">
			<div class="mb-8 flex items-baseline justify-between gap-6">
				<h2 class="display text-[1.9rem] md:text-[2.3rem]">Blog</h2>
				<a href="/blog" class="green-link shrink-0 text-[0.92rem] font-medium">All posts &amp; RSS →</a>
			</div>

			<div class="grid items-start gap-8 lg:grid-cols-[0.95fr_1.05fr] lg:gap-10">
				{
					leadPost && (
						<a
							href={leadPost.url}
							class="group block overflow-hidden rounded-xl border border-line bg-bg transition-colors hover:border-line-strong"
						>
							<div class="border-b border-line bg-[#020617]/55 p-4">
								<img
									src={leadPost.frontmatter.cover}
									class="aspect-video w-full object-contain"
									alt=""
								/>
							</div>
							<div class="p-5 sm:p-6">
								<span class="label">{formatDate(leadPost.frontmatter.date)}</span>
								<h3 class="display mt-1.5 text-[1.45rem] transition-colors group-hover:text-accent-ink">
									{leadPost.frontmatter.title}
								</h3>
								<p class="mt-2 text-[0.94rem] leading-relaxed text-ink-3">{leadPost.frontmatter.description}</p>
							</div>
						</a>
					)
				}

				<div class="overflow-hidden rounded-xl border border-line bg-bg divide-y divide-line">
					{
						recentPosts.map((post) => (
							<a
								href={post.url}
								class="group grid grid-cols-[5.5rem_1fr] items-center gap-4 p-4 transition-colors hover:bg-tint sm:grid-cols-[7.5rem_1fr] sm:gap-5"
							>
								<div class="overflow-hidden rounded-lg border border-line bg-[#020617]/55 p-1.5">
									<img
										src={post.frontmatter.cover}
										class="aspect-video w-full object-contain"
										alt=""
										loading="lazy"
									/>
								</div>
								<div class="min-w-0">
									<div class="flex flex-wrap items-baseline justify-between gap-x-3 gap-y-0.5">
										<h3 class="font-semibold leading-snug text-ink transition-colors group-hover:text-accent-ink">
											{post.frontmatter.title}
										</h3>
										<span class="label shrink-0">{formatDate(post.frontmatter.date)}</span>
									</div>
									<p class="mt-1 line-clamp-2 text-[0.86rem] leading-relaxed text-ink-3">
										{post.frontmatter.description}
									</p>
								</div>
							</a>
						))
					}
				</div>
			</div>
		</div>
	</section>

	<!-- Self-host or managed: vertical hairline split (extra bottom padding gives the peeking footer cat room) -->
	<section>
		<div class="mx-auto max-w-6xl px-5 pb-24 pt-14 md:px-8 md:pb-28 md:pt-16">
			<div class="mb-10 flex flex-wrap items-end justify-between gap-4">
				<div>
					<img src="/drawn/open.svg" class="mb-1.5 h-8 w-auto -rotate-2" alt="open and optional" />
					<h2 class="display text-[1.9rem] md:text-[2.3rem]">Self-host or managed</h2>
				</div>
				<span class="label">MIT / Apache 2.0</span>
			</div>

			<div class="grid gap-10 md:grid-cols-2 md:gap-0">
				<div class="flex flex-col md:pr-10">
					<span class="label">Open source</span>
					<h3 class="display mt-2 text-[1.45rem]">Self-host</h3>
					<p class="mt-3 text-[0.95rem] leading-relaxed text-ink-3">
						Deploy <code class="font-mono text-[0.86em] text-ink">moq-relay</code> anywhere. Clusters discover each
						other, route by the shortest path, and fail over without a central controller.
					</p>
					<ul class="mt-5 flex flex-col gap-2 text-[0.92rem] text-ink-2">
						<li><span class="mr-2 text-accent">✓</span>No license fees, no lock-in</li>
						<li><span class="mr-2 text-accent">✓</span>Compatible with any MoQ CDN</li>
						<li><span class="mr-2 text-accent">✓</span>Community support on Discord</li>
					</ul>
					<div class="mt-auto flex flex-wrap gap-3 pt-7">
						<a href="https://doc.moq.dev/bin/relay/" class="btn-line">Relay docs</a>
						<a href="https://github.com/moq-dev/moq" class="btn-line">GitHub</a>
					</div>
				</div>

				<div class="flex flex-col border-t border-line pt-10 md:border-l md:border-t-0 md:pl-10 md:pt-0">
					<span class="label text-accent-ink!">Managed CDN</span>
					<h3 class="display mt-2 flex items-center gap-2.5 text-[1.45rem]">
						moq.pro
						<img src="/layout/pro-icon.svg" class="h-6 w-auto" alt="" />
					</h3>
					<p class="mt-3 text-[0.95rem] leading-relaxed text-ink-3">
						A global MoQ CDN run by the people who created MoQ. Every user lands on the nearest edge, with no
						regions to pick.
					</p>
					<ul class="mt-5 flex flex-col gap-2 text-[0.92rem] text-ink-2">
						<li><span class="mr-2 text-accent">✓</span>400 GB of delivery free every month</li>
						<li><span class="mr-2 text-accent">✓</span>Up and running in minutes, nothing to operate</li>
						<li>
							<span class="mr-2 text-accent">✓</span>Direct support from the maintainers (<a
								href="mailto:hello@kixel.us"
								class="green-link"
							>say hi</a>)
						</li>
					</ul>
					<div class="mt-auto flex flex-wrap gap-3 pt-7">
						<a href={proUrl} class="btn-green">Get started <span aria-hidden="true">→</span></a>
						<a href="mailto:hello@kixel.us" class="btn-line">Talk to us</a>
					</div>
				</div>
			</div>
		</div>
	</section>
</Layout>
