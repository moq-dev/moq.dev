---
// DEMOQED — de.moq.dev
// Deliberately standalone: no global layout, no nav, no Tailwind. Just a very
// tall stack of DE MOQ ED where the MOQ column walks the color wheel on the
// way down.
const ROWS = 16;

// Start on the moq.dev green and make exactly one lap so the bottom row lands
// back where the top row started.
const HUE_START = 142;
const HUE_SWEEP = 360;

const rows = Array.from({ length: ROWS }, (_, i) => ({
	hue: (HUE_START + (HUE_SWEEP * i) / ROWS) % 360,
}));

const agenda = [
	["12:30", "doors open · coffee"],
	["1:00", "welcome from the MoQ Alliance"],
	["1:10", "talk 01"],
	["1:40", "talk 02"],
	["2:10", "talk 03"],
	["2:40", "break"],
	["3:00", "talk 04"],
	["3:30", "talk 05"],
	["4:00", "talk 06"],
	["4:30", "demos + lightning talks"],
	["5:00", "talks wrap"],
	["6:00", "happy hour"],
	["8:00", "last call"],
];

const members = [
	["Akamai", "https://www.akamai.com", "akamai.svg"],
	["AWS", "https://aws.amazon.com", "aws.png"],
	["Bitmovin", "https://bitmovin.com", "bitmovin.png"],
	["Cisco", "https://cisco.com", "cisco.svg"],
	["Cloudflare", "https://cloudflare.com", "cloudflare.svg"],
	["Datum", "https://www.datum.net", "datum.svg"],
	["Demuxed", "https://demuxed.com", "demuxed.png"],
	["Fastly", "https://fastly.com", "fastly.svg"],
	["Iroh", "https://iroh.computer", "iroh.png"],
	["moq.pro", "https://moq.pro", "/layout/pro-icon.svg"],
	["MOQtail", "https://github.com/moqtail", "moqtail.png"],
	["Mux", "https://mux.com", "mux.svg"],
	["Norsk", "https://norsk.video", "norsk.png"],
	["OpenMOQ", "https://openmoq.org", "openmoq.svg"],
	["Qualabs", "https://qualabs.com", "qualabs.svg"],
	["Red5", "https://www.red5.net", "red5.png"],
	["Software Mansion", "https://swmansion.com", "software-mansion.png"],
];

const title = "DEMOQED";
const description =
	"DEMOQED is an afternoon about Media over QUIC. October 8, 2026 in San Francisco.";
const siteUrl = import.meta.env.MODE === "staging" ? "https://new.moq.dev" : "https://de.moq.dev";
const pageUrl = import.meta.env.MODE === "staging" ? `${siteUrl}/de/` : `${siteUrl}/`;
const socialImage = `${siteUrl}/de/social.png`;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>DEMOQED — October 8 · San Francisco</title>
		<meta name="description" content={description} />
		<link rel="icon" type="image/svg+xml" href="/de/favicon.svg" />

		<meta property="og:type" content="website" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={pageUrl} />
		<meta property="og:site_name" content="DEMOQED" />
		<meta property="og:image" content={socialImage} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:image:alt" content="DEMOQED — October 8, 2026 in San Francisco" />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={socialImage} />
		<meta name="twitter:image:alt" content="DEMOQED — October 8, 2026 in San Francisco" />

		<meta name="theme-color" content="#08070a" />

		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			rel="stylesheet"
			href="https://fonts.googleapis.com/css2?family=Anton&family=DM+Mono:wght@400;500&display=swap"
		/>

		<style is:inline>
			:root {
				--ink: #08070a;
				--paper: #efe9dd;
				--dim: #6d6a72;
				--gutter: clamp(0.75rem, 3vw, 2.5rem);
			}

			* {
				box-sizing: border-box;
			}

			html {
				background: var(--ink);
				scroll-behavior: smooth;
			}

			body {
				margin: 0;
				background: var(--ink);
				color: var(--paper);
				font-family: "DM Mono", ui-monospace, monospace;
				overflow-x: hidden;
				/* Faint vignette so the color column reads hotter in the middle. */
				background-image: radial-gradient(120% 60% at 50% 50%, #14121a 0%, #08070a 70%);
				background-attachment: fixed;
			}

			/* Film grain over everything, pinned to the viewport. */
			body::after {
				content: "";
				position: fixed;
				inset: 0;
				z-index: 50;
				pointer-events: none;
				opacity: 0.16;
				mix-blend-mode: overlay;
				background-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='160' height='160'><filter id='n'><feTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='3'/></filter><rect width='160' height='160' filter='url(%23n)'/></svg>");
			}

			/* ---------- fixed chrome ---------- */

			.rail {
				position: fixed;
				top: 0;
				left: 0;
				right: 0;
				z-index: 40;
				display: flex;
				justify-content: space-between;
				align-items: baseline;
				gap: 1rem;
				padding: var(--gutter) var(--gutter) 2.5rem;
				font-size: clamp(0.6rem, 1.4vw, 0.8rem);
				letter-spacing: 0.18em;
				text-transform: uppercase;
				pointer-events: none;
				/* Scrim so the rail stays legible over whatever letter is behind it. */
				background: linear-gradient(to bottom, rgb(8 7 10 / 95%) 35%, rgb(8 7 10 / 0%));
			}

			.rail a {
				pointer-events: auto;
				color: inherit;
				text-decoration: none;
				border-bottom: 1px solid currentColor;
				padding-bottom: 0.15em;
			}

			.rail .sponsor {
				color: var(--dim);
			}

			.rail .sponsor a {
				color: var(--paper);
			}

			/* The organizer is the one that has to stay on a phone. */
			@media (max-width: 640px) {
				.rail .date {
					display: none;
				}
			}

			.progress {
				position: fixed;
				top: 0;
				left: 0;
				height: 3px;
				width: 100%;
				z-index: 60;
				transform-origin: 0 50%;
				transform: scaleX(0);
				background: linear-gradient(
					90deg,
					hsl(142 100% 55%),
					hsl(200 100% 55%),
					hsl(280 100% 62%),
					hsl(340 100% 60%),
					hsl(40 100% 55%)
				);
				animation: fill linear both;
				animation-timeline: scroll(root);
			}

			@keyframes fill {
				to {
					transform: scaleX(1);
				}
			}

			/* ---------- the stack ---------- */

			.stack {
				padding: 4vh 0 6vh;
			}

			.row {
				display: flex;
				justify-content: center;
				align-items: baseline;
				/* No gap: DEMOQED reads as one word and the color does the dividing. */
				gap: 0;
				padding: 0 var(--gutter);
				font-family: "Anton", "Arial Narrow", sans-serif;
				font-size: max(3rem, 16.5vw);
				line-height: 0.92;
				letter-spacing: -0.01em;
				text-transform: uppercase;
				white-space: nowrap;
				user-select: none;
			}

			/* DE and ED are both two letters, so space-between parks MOQ dead
			   center and every row's color column lines up. */
			.row span {
				display: block;
			}

			.row .fixed {
				color: var(--paper);
				opacity: 0.9;
			}

			.row .moq {
				color: hsl(var(--h) 92% 58%);
				text-shadow: 0 0 clamp(20px, 5vw, 70px) hsl(var(--h) 100% 50% / 0.35);
				animation: breathe linear both;
				animation-timeline: view();
				animation-range: cover 15% cover 85%;
			}

			/* Scroll-driven where supported; harmless everywhere else. */
			@keyframes breathe {
				0% {
					opacity: 0.45;
					transform: scale(0.98);
				}
				50% {
					opacity: 1;
					transform: scale(1.02);
				}
				100% {
					opacity: 0.45;
					transform: scale(0.98);
				}
			}

			/* Narrow screens: push the type wider so the block still reaches the
			   gutters instead of floating in the middle. */
			@media (max-width: 640px) {
				.row {
					font-size: 21.5vw;
				}
			}

			.aside {
				position: relative;
				isolation: isolate;
				width: min(calc(100% - 2 * var(--gutter)), 68rem);
				margin: clamp(3rem, 10vh, 8rem) auto;
				padding: clamp(2rem, 6vw, 5rem);
				background: rgb(239 233 221 / 96%);
				color: var(--ink);
				box-shadow:
					0 0 0 1px hsl(var(--accent-h) 92% 58% / 45%),
					0 0 80px hsl(var(--accent-h) 100% 50% / 18%);
			}

			.aside::before {
				content: "";
				position: absolute;
				inset: 0 0 auto;
				height: 0.45rem;
				background: linear-gradient(
					90deg,
					hsl(var(--accent-h) 92% 48%),
					hsl(calc(var(--accent-h) + 55) 100% 52%)
				);
			}

			.kicker {
				margin: 0 0 1.5rem;
				font-size: 0.72rem;
				font-weight: 500;
				letter-spacing: 0.24em;
				text-transform: uppercase;
				color: hsl(var(--accent-h) 70% 30%);
			}

			.aside h2 {
				max-width: 13ch;
				margin: 0;
				font-family: "Anton", "Arial Narrow", sans-serif;
				font-size: clamp(2.4rem, 6.5vw, 5.25rem);
				font-weight: 400;
				line-height: 0.92;
				letter-spacing: -0.015em;
				text-transform: uppercase;
				text-wrap: balance;
			}

			.aside .lede {
				max-width: 44rem;
				margin: clamp(2rem, 5vw, 3.5rem) 0 0;
				font-size: clamp(0.95rem, 1.8vw, 1.2rem);
				line-height: 1.65;
			}

			.aside .lede + .lede {
				margin-top: 1rem;
			}

			.event-facts {
				display: grid;
				grid-template-columns: minmax(14rem, 0.7fr) minmax(24rem, 1.3fr);
				gap: clamp(2rem, 7vw, 6rem);
				max-width: 60rem;
				margin: clamp(2rem, 5vw, 3.5rem) 0 0;
			}

			.event-facts div {
				min-width: 0;
			}

			.event-facts dt {
				font-size: 0.72rem;
				font-weight: 500;
				letter-spacing: 0.24em;
				text-transform: uppercase;
				color: hsl(var(--accent-h) 70% 30%);
			}

			.event-facts dd {
				margin: 0.65rem 0 0;
				font-family: "Anton", "Arial Narrow", sans-serif;
				font-size: clamp(2.8rem, 6vw, 5rem);
				line-height: 0.92;
				text-transform: uppercase;
				white-space: nowrap;
			}

			.event-facts .venue {
				font-size: clamp(2.4rem, 5vw, 4.25rem);
			}

			.event-facts .venue-detail {
				display: block;
				margin-top: 0.65rem;
				font-family: "DM Mono", ui-monospace, monospace;
				font-size: clamp(0.75rem, 1.5vw, 0.95rem);
				font-weight: 500;
				letter-spacing: 0.16em;
				line-height: 1.2;
				text-transform: uppercase;
				color: #55515a;
			}

			.aside a {
				color: inherit;
				text-underline-offset: 0.25em;
				text-decoration-thickness: 2px;
				text-decoration-color: hsl(var(--accent-h) 92% 42%);
			}

			.split {
				display: grid;
				grid-template-columns: minmax(0, 1.1fr) minmax(16rem, 0.9fr);
				gap: clamp(2rem, 7vw, 6rem);
				align-items: end;
			}

			.split .lede {
				margin-top: 0;
			}

			.member-wall {
				display: grid;
				grid-template-columns: repeat(auto-fit, minmax(6rem, 1fr));
				gap: 0.5rem;
				margin-top: clamp(2.5rem, 6vw, 4rem);
				padding: 0;
				list-style: none;
			}

			.member-wall li {
				display: flex;
			}

			.aside a.member {
				position: relative;
				display: flex;
				align-items: center;
				justify-content: center;
				min-height: 4.5rem;
				width: 100%;
				padding: 0.8rem;
				background: #fff;
				border: 1px solid rgb(8 7 10 / 18%);
				overflow: hidden;
				text-decoration: none;
				transition: transform 120ms ease;
			}

			.aside a.member::after {
				content: attr(data-name);
				position: absolute;
				inset: auto 0 0;
				padding: 0.25rem 0.4rem;
				background: rgb(8 7 10 / 90%);
				color: var(--paper);
				font-size: 0.55rem;
				font-weight: 500;
				letter-spacing: 0.08em;
				line-height: 1.2;
				text-align: center;
				text-transform: uppercase;
				transform: translateY(100%);
				transition: transform 120ms ease;
			}

			.member img {
				display: block;
				max-width: 100%;
				max-height: 2.5rem;
				object-fit: contain;
			}

			.member img.member-logo-large {
				width: 3rem;
				height: 3rem;
				max-width: none;
				max-height: none;
			}

			.member:hover {
				transform: translateY(-2px);
			}

			.member:hover::after,
			.member:focus-visible::after {
				transform: translateY(0);
			}

			.join {
				margin: clamp(1.5rem, 4vw, 2.5rem) 0 0;
				font-size: 0.78rem;
				font-weight: 500;
				letter-spacing: 0.12em;
				text-align: center;
				text-transform: uppercase;
			}

			.agenda {
				list-style: none;
				margin: clamp(2.5rem, 6vw, 4rem) 0 0;
				padding: 0;
				border-top: 2px solid var(--ink);
			}

			.agenda li {
				display: grid;
				grid-template-columns: 5rem 1fr;
				gap: 1.25rem;
				padding: 0.85rem 0;
				border-bottom: 1px solid rgb(8 7 10 / 24%);
				font-size: clamp(0.8rem, 1.8vw, 1rem);
				text-transform: uppercase;
			}

			.agenda time {
				color: hsl(var(--accent-h) 70% 30%);
				font-weight: 500;
			}

			.actions {
				display: flex;
				flex-wrap: wrap;
				gap: 0.75rem;
				margin-top: clamp(2rem, 5vw, 3.5rem);
			}

			.schedule-head {
				display: grid;
				grid-template-columns: minmax(0, 1fr) auto;
				gap: clamp(2rem, 8vw, 7rem);
				align-items: start;
			}

			.ticket-summary {
				min-width: clamp(11rem, 20vw, 16rem);
				text-align: right;
			}

			.ticket-summary .kicker {
				margin-bottom: 0.75rem;
			}

			.schedule-cta {
				width: min(100%, 40rem);
				margin: clamp(1.5rem, 4vw, 3rem) 0 0 auto;
			}

			.schedule-cta .actions {
				justify-content: flex-end;
				margin-top: 0;
			}

			.button {
				display: inline-block;
				padding: 1rem 1.4rem;
				border: 2px solid var(--ink);
				font-family: "Anton", "Arial Narrow", sans-serif;
				font-size: 1.05rem;
				letter-spacing: 0.06em;
				line-height: 1;
				text-decoration: none;
				text-transform: uppercase;
			}

			.button-primary {
				background: hsl(var(--accent-h) 92% 55%);
				color: var(--ink);
			}

			.button-secondary {
				background: transparent;
			}

			.price {
				margin: 0;
				font-family: "Anton", "Arial Narrow", sans-serif;
				font-size: clamp(5rem, 13vw, 9rem);
				line-height: 0.8;
				letter-spacing: -0.02em;
			}

			.note {
				margin: 1.5rem 0 0;
				font-size: 0.78rem;
				line-height: 1.7;
				letter-spacing: 0.08em;
				text-transform: uppercase;
				color: #55515a;
			}

			.schedule-note {
				margin-top: clamp(1.5rem, 4vw, 2.5rem);
				text-align: center;
			}

			.fin {
				position: relative;
				padding: clamp(3rem, 8vw, 7rem) var(--gutter);
				background: var(--paper);
				color: var(--ink);
				text-align: center;
			}

			.fin::before {
				content: "";
				position: absolute;
				inset: 0 0 auto;
				height: 0.5rem;
				background: linear-gradient(90deg, hsl(142 92% 48%), hsl(197 100% 52%));
			}

			.fin span {
				display: block;
				font-family: "Anton", "Arial Narrow", sans-serif;
				font-size: clamp(5rem, 18vw, 14rem);
				line-height: 0.8;
				letter-spacing: -0.015em;
			}

			.sr-only {
				position: absolute;
				width: 1px;
				height: 1px;
				padding: 0;
				margin: -1px;
				overflow: hidden;
				clip: rect(0, 0, 0, 0);
				white-space: nowrap;
				border: 0;
			}

			.nowrap {
				white-space: nowrap;
			}

			.scrollhint {
				text-align: center;
				font-size: 0.7rem;
				letter-spacing: 0.3em;
				text-transform: uppercase;
				color: var(--dim);
				/* Clear the fixed rail above it. */
				padding: calc(var(--gutter) + 3rem) 0 1vh;
			}

			.scrollhint span {
				display: inline-block;
				animation: nudge 2.2s ease-in-out infinite;
			}

			@keyframes nudge {
				0%,
				100% {
					transform: translateY(0);
					opacity: 0.5;
				}
				50% {
					transform: translateY(6px);
					opacity: 1;
				}
			}

			@media (prefers-reduced-motion: reduce) {
				html {
					scroll-behavior: auto;
				}
				.row .moq,
				.scrollhint span,
				.progress,
				.member,
				.member::after {
					animation: none;
					transition: none;
				}
				.progress {
					display: none;
				}
			}

			@media (max-width: 900px) {
				.event-facts {
					grid-template-columns: 1fr;
					gap: 2rem;
				}
			}

			@media (max-width: 720px) {
				.aside {
					padding: 2.5rem 1.25rem;
				}

				.split {
					grid-template-columns: 1fr;
				}

				.schedule-head {
					grid-template-columns: 1fr;
					gap: 2rem;
				}

				.ticket-summary {
					text-align: left;
				}

				.schedule-cta {
					margin-left: 0;
				}

				.schedule-cta .actions {
					justify-content: flex-start;
				}

				.agenda li {
					grid-template-columns: 4rem 1fr;
					gap: 0.75rem;
				}

				.button {
					flex: 1 1 12rem;
					text-align: center;
				}
			}
		</style>
	</head>
	<body>
		<div class="progress" aria-hidden="true"></div>

		<div class="rail">
			<span class="sponsor">
				organized by <a href="https://moqalliance.org">moqalliance.org ↗</a>
			</span>
			<span class="date">oct 8 · sf</span>
		</div>

		<div class="scrollhint"><span>scroll ↓</span></div>

		<main class="stack" aria-label="DEMOQED">
			<h1 class="sr-only">DEMOQED — the MoQ Alliance conference</h1>
			{
				rows.map(({ hue }, i) => (
					<>
						<div class="row" aria-hidden={i > 0 ? "true" : undefined}>
							<span class="fixed">DE</span>
							<span class="moq" style={`--h:${hue.toFixed(1)}`}>
								MOQ
							</span>
							<span class="fixed">ED</span>
						</div>
						{i === 3 && (
							<section class="aside" style="--accent-h:165">
								<p class="kicker">Demuxed is taking a break in 2026</p>
								<h2>Let's talk about MoQ instead</h2>
								<p class="lede">
									DEMOQED is an afternoon for people building Media over QUIC.
									Talks, demos, and drinks.
								</p>
								<dl class="event-facts">
									<div>
										<dt>when</dt>
										<dd>October 8</dd>
									</div>
									<div>
										<dt>where</dt>
										<dd class="venue">
											San Francisco
											<a class="venue-detail" href="https://share.google/DPkfeck6IG5HjEPpf"
												>Alamo Drafthouse</a
											>
										</dd>
									</div>
								</dl>
								<p class="lede">
									Thursday during <a href="https://www.tech-week.com/"
										>SF Tech Week</a
									>. <span class="nowrap">150–200 nerds.</span>
								</p>
							</section>
						)}

						{i === 7 && (
							<section class="aside" style="--accent-h:265">
								<div class="split">
									<div>
										<p class="kicker">organized by</p>
										<h2>MoQ Alliance</h2>
									</div>
									<div>
										<p class="lede">
											We're a collection of companies and open-source projects
											implementing MoQ. We want it to succeed, so we're getting
											everybody in one room.
										</p>
										<p class="lede">
											Protocol work happens at the <a
												href="https://datatracker.ietf.org/wg/moq/about/"
												>IETF</a
											>. <a href="https://moqalliance.org">MoQ Alliance</a> is for
											applications, deployments, demos, and bugs.
										</p>
									</div>
								</div>
								<ul class="member-wall" aria-label="MoQ Alliance members">
									{members.map(([name, url, logo]) => (
										<li>
											<a
												class="member"
												href={url}
												data-name={name}
												rel="noreferrer"
												referrerpolicy="no-referrer"
											>
												<img
													class:list={{ "member-logo-large": name === "Mux" || name === "Red5" }}
													src={logo.startsWith("/") ? logo : `https://moqalliance.org/logos/${logo}`}
													alt={name}
													loading="lazy"
												/>
											</a>
										</li>
									))}
								</ul>
								<p class="join">
									<a href="mailto:hello@moqalliance.org?subject=Joining%20the%20MoQ%20Alliance"
										>Email if you want to join</a
									>
								</p>
							</section>
						)}

						{i === 11 && (
							<section class="aside" style="--accent-h:325">
								<div class="schedule-head">
									<div>
										<p class="kicker">agenda · program in progress</p>
										<h2>Schedule</h2>
									</div>
									<div class="ticket-summary">
										<p class="kicker">tickets</p>
										<p class="price">$99</p>
									</div>
								</div>
								<div class="schedule-cta">
									<div class="actions">
										<a
											class="button button-primary"
											href="https://ti.to/moq-alliance/demoqed-2026"
											>register ↗</a
										>
										<a
											class="button button-secondary"
											href="mailto:hello@moqalliance.org?subject=DEMOQED%202026%20talk%20submission"
											>submit a talk</a
										>
									</div>
				</div>
				<ol class="agenda">
									{agenda.map(([time, item]) => (
										<li>
											<time>{time}</time>
											<span>{item}</span>
										</li>
					))}
				</ol>
				<p class="note schedule-note">Want to sponsor? Buy tickets for people instead.</p>
			</section>
						)}
					</>
				))
			}
		</main>

		<footer class="fin"><span>FIN</span></footer>
	</body>
</html>
