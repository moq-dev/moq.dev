---
// DEMOQED — de.moq.dev
// Deliberately standalone: no global layout, no nav, no Tailwind. Just a very
// tall stack of DE MOQ ED where the MOQ column walks the color wheel on the
// way down.
const ROWS = 64;

// Start on the moq.dev green and make exactly one lap so the bottom row lands
// back where the top row started.
const HUE_START = 142;
const HUE_SWEEP = 360;

const rows = Array.from({ length: ROWS }, (_, i) => ({
	hue: (HUE_START + (HUE_SWEEP * i) / ROWS) % 360,
}));

// Slotted between rows at these indices (drawn *after* row N).
const asides = new Map([
	[3, "demuxed is canceled this year."],
	[14, "so we're throwing our own thing."],
	// Non-breaking space so a narrow window never splits the city name.
	[25, "thursday, october 8 · san\u00a0francisco"],
	[36, "talk about moq stuff i guess."],
	[47, "venue, tickets: tbd"],
	[58, "see you in october."],
]);

const title = "DEMOQED";
const description = "Demuxed is canceled, so we're doing our own thing. October 8, San Francisco.";
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>DEMOQED — October 8 · San Francisco</title>
		<meta name="description" content={description} />
		<link rel="icon" type="image/svg+xml" href="/layout/favicon.svg" />
		<link rel="icon" type="image/png" href="/layout/favicon.png" />

		<meta property="og:type" content="website" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content="https://de.moq.dev" />
		<meta property="og:site_name" content="DEMOQED" />
		<meta property="og:image" content="https://moq.dev/layout/icon.png" />
		<meta name="twitter:card" content="summary" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />

		<meta name="theme-color" content="#08070a" />

		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			rel="stylesheet"
			href="https://fonts.googleapis.com/css2?family=Anton&family=DM+Mono:wght@400;500&display=swap"
		/>

		<style is:inline>
			:root {
				--ink: #08070a;
				--paper: #efe9dd;
				--dim: #6d6a72;
				--gutter: clamp(0.75rem, 3vw, 2.5rem);
			}

			* {
				box-sizing: border-box;
			}

			html {
				background: var(--ink);
				scroll-behavior: smooth;
			}

			body {
				margin: 0;
				background: var(--ink);
				color: var(--paper);
				font-family: "DM Mono", ui-monospace, monospace;
				overflow-x: hidden;
				/* Faint vignette so the color column reads hotter in the middle. */
				background-image: radial-gradient(120% 60% at 50% 50%, #14121a 0%, #08070a 70%);
				background-attachment: fixed;
			}

			/* Film grain over everything, pinned to the viewport. */
			body::after {
				content: "";
				position: fixed;
				inset: 0;
				z-index: 50;
				pointer-events: none;
				opacity: 0.16;
				mix-blend-mode: overlay;
				background-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='160' height='160'><filter id='n'><feTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='3'/></filter><rect width='160' height='160' filter='url(%23n)'/></svg>");
			}

			/* ---------- fixed chrome ---------- */

			.rail {
				position: fixed;
				top: 0;
				left: 0;
				right: 0;
				z-index: 40;
				display: flex;
				justify-content: space-between;
				align-items: baseline;
				gap: 1rem;
				padding: var(--gutter) var(--gutter) 2.5rem;
				font-size: clamp(0.6rem, 1.4vw, 0.8rem);
				letter-spacing: 0.18em;
				text-transform: uppercase;
				pointer-events: none;
				/* Scrim so the rail stays legible over whatever letter is behind it. */
				background: linear-gradient(to bottom, rgb(8 7 10 / 95%) 35%, rgb(8 7 10 / 0%));
			}

			.rail a {
				pointer-events: auto;
				color: inherit;
				text-decoration: none;
				border-bottom: 1px solid currentColor;
				padding-bottom: 0.15em;
			}

			.rail .sponsor {
				color: var(--dim);
			}

			.rail .sponsor a {
				color: var(--paper);
			}

			/* The organizer is the one that has to stay on a phone. */
			@media (max-width: 640px) {
				.rail .date {
					display: none;
				}
			}

			.progress {
				position: fixed;
				top: 0;
				left: 0;
				height: 3px;
				width: 100%;
				z-index: 60;
				transform-origin: 0 50%;
				transform: scaleX(0);
				background: linear-gradient(
					90deg,
					hsl(142 100% 55%),
					hsl(200 100% 55%),
					hsl(280 100% 62%),
					hsl(340 100% 60%),
					hsl(40 100% 55%)
				);
				animation: fill linear both;
				animation-timeline: scroll(root);
			}

			@keyframes fill {
				to {
					transform: scaleX(1);
				}
			}

			/* ---------- the stack ---------- */

			.stack {
				padding: 4vh 0 6vh;
			}

			.row {
				display: flex;
				justify-content: center;
				align-items: baseline;
				/* No gap: DEMOQED reads as one word and the color does the dividing. */
				gap: 0;
				padding: 0 var(--gutter);
				font-family: "Anton", "Arial Narrow", sans-serif;
				font-size: max(3rem, 16.5vw);
				line-height: 0.92;
				letter-spacing: -0.01em;
				text-transform: uppercase;
				white-space: nowrap;
				user-select: none;
			}

			/* DE and ED are both two letters, so space-between parks MOQ dead
			   center and every row's color column lines up. */
			.row span {
				display: block;
			}

			.row .fixed {
				color: var(--paper);
				opacity: 0.9;
			}

			.row .moq {
				color: hsl(var(--h) 92% 58%);
				text-shadow: 0 0 clamp(20px, 5vw, 70px) hsl(var(--h) 100% 50% / 0.35);
				animation: breathe linear both;
				animation-timeline: view();
				animation-range: cover 15% cover 85%;
			}

			/* Scroll-driven where supported; harmless everywhere else. */
			@keyframes breathe {
				0% {
					opacity: 0.45;
					transform: scale(0.98);
				}
				50% {
					opacity: 1;
					transform: scale(1.02);
				}
				100% {
					opacity: 0.45;
					transform: scale(0.98);
				}
			}

			/* Narrow screens: push the type wider so the block still reaches the
			   gutters instead of floating in the middle. */
			@media (max-width: 640px) {
				.row {
					font-size: 21.5vw;
				}
			}

			.aside {
				padding: clamp(2rem, 6vh, 5rem) var(--gutter);
				text-align: center;
				font-size: clamp(0.85rem, 2vw, 1.35rem);
				letter-spacing: 0.24em;
				text-transform: uppercase;
				color: var(--paper);
				/* Roomy enough that the rule under a wrapped line can't collide
				   with the line below it. */
				line-height: 2.4;
				text-wrap: balance;
			}

			.aside span {
				border-bottom: 2px solid currentColor;
				padding-bottom: 0.4em;
				box-decoration-break: clone;
			}

			.scrollhint {
				text-align: center;
				font-size: 0.7rem;
				letter-spacing: 0.3em;
				text-transform: uppercase;
				color: var(--dim);
				/* Clear the fixed rail above it. */
				padding: calc(var(--gutter) + 3rem) 0 1vh;
			}

			.scrollhint span {
				display: inline-block;
				animation: nudge 2.2s ease-in-out infinite;
			}

			@keyframes nudge {
				0%,
				100% {
					transform: translateY(0);
					opacity: 0.5;
				}
				50% {
					transform: translateY(6px);
					opacity: 1;
				}
			}

			@media (prefers-reduced-motion: reduce) {
				html {
					scroll-behavior: auto;
				}
				.row .moq,
				.scrollhint span,
				.progress {
					animation: none;
				}
				.progress {
					display: none;
				}
			}
		</style>
	</head>
	<body>
		<div class="progress" aria-hidden="true"></div>

		<div class="rail">
			<span class="sponsor">
				organized by <a href="https://moqalliance.org">moqalliance.org ↗</a>
			</span>
			<span class="date">oct 8 · sf</span>
		</div>

		<div class="scrollhint"><span>scroll ↓</span></div>

		<main class="stack" aria-label="DEMOQED">
			{
				rows.map(({ hue }, i) => (
					<>
						<div class="row" aria-hidden={i > 0 ? "true" : undefined}>
							<span class="fixed">DE</span>
							<span class="moq" style={`--h:${hue.toFixed(1)}`}>
								MOQ
							</span>
							<span class="fixed">ED</span>
						</div>
						{asides.has(i) && (
							<p class="aside">
								<span>{asides.get(i)}</span>
							</p>
						)}
					</>
				))
			}
		</main>

	</body>
</html>
