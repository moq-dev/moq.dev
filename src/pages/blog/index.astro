---
import MainLayout from "../../layouts/global.astro";

interface Frontmatter {
	title: string;
	cover: string;
	description: string;
	author: string;
	date: string;
}

const posts = Object.values(
	await import.meta.glob<{ frontmatter: Frontmatter; url: string }>("./*.mdx", { eager: true }),
);
posts.sort((a, b) => Date.parse(b.frontmatter.date) - Date.parse(a.frontmatter.date));

const [featured, ...rest] = posts;

const formatDate = (date: string) =>
	new Date(date).toLocaleDateString("en-US", { year: "numeric", month: "short", day: "numeric", timeZone: "UTC" });
---

<MainLayout title="Blog" description="Blog posts and fun stuff" bare>
	<section class="mx-auto max-w-6xl px-5 pb-24 pt-14 md:px-8">
		<div class="mb-12 flex items-end justify-between gap-6">
			<div>
				<h1 class="display text-[2.6rem] md:text-[3.4rem]"><span class="scribble">Blog</span></h1>
				<p class="mt-4 text-[1.05rem] text-ink-3">Hot takes on live media, QUIC, and building MoQ in the open.</p>
			</div>
			<a href="/rss.xml" class="green-link shrink-0 text-[0.95rem]">RSS</a>
		</div>

		{
			featured && (
				<a
					href={featured.url}
					class="group mb-12 grid items-center gap-8 border-y border-line py-8 transition-colors hover:bg-tint md:grid-cols-[1.05fr_1fr] md:px-3"
				>
					<div class="overflow-hidden rounded-xl border border-line bg-surface p-4 transition-colors group-hover:border-line-strong">
						<img
							class="aspect-video w-full object-contain"
							src={featured.frontmatter.cover}
							alt=""
						/>
					</div>
					<div>
						<span class="label">{formatDate(featured.frontmatter.date)}</span>
						<h2 class="display mt-2 text-[1.8rem] transition-colors group-hover:text-accent-ink md:text-[2.2rem]">
							{featured.frontmatter.title}
						</h2>
						<p class="mt-3 text-[1rem] leading-relaxed text-ink-3">{featured.frontmatter.description}</p>
					</div>
				</a>
			)
		}

		<ul class="border-t border-line">
			{
				rest.map((post) => (
					<li class="border-b border-line">
						<a
							href={post.url}
							class="group grid grid-cols-1 items-center gap-4 px-2 py-5 transition-colors hover:bg-tint sm:grid-cols-[9rem_1fr_auto] sm:gap-6"
						>
							<div class="overflow-hidden rounded-lg border border-line bg-surface p-2">
								<img
									class="aspect-video w-full object-contain"
									src={post.frontmatter.cover}
									alt=""
									loading="lazy"
								/>
							</div>
							<div>
								<span class="label sm:hidden">{formatDate(post.frontmatter.date)}</span>
								<h3 class="text-[1.15rem] font-semibold leading-snug text-ink transition-colors group-hover:text-accent-ink">
									{post.frontmatter.title}
								</h3>
								<p class="mt-1 text-[0.9rem] leading-relaxed text-ink-3">{post.frontmatter.description}</p>
							</div>
							<span class="label hidden shrink-0 sm:block">{formatDate(post.frontmatter.date)}</span>
						</a>
					</li>
				))
			}
		</ul>
	</section>
</MainLayout>
