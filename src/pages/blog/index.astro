---
import MainLayout from "../../layouts/global.astro";

interface Frontmatter {
	title: string;
	cover: string;
	description: string;
	author: string;
	date: string;
}

const posts = Object.values(
	await import.meta.glob<{ frontmatter: Frontmatter; url: string }>("./*.mdx", { eager: true }),
);
posts.sort((a, b) => Date.parse(b.frontmatter.date) - Date.parse(a.frontmatter.date));
const [latest, ...rest] = posts;
if (!latest) throw new Error("no blog posts");

// Everything older, one wall per year.
const years = Map.groupBy(rest, (post) => new Date(post.frontmatter.date).getUTCFullYear());

const formatDate = (date: string) =>
	new Date(date).toLocaleDateString("en-US", { year: "numeric", month: "short", day: "numeric", timeZone: "UTC" });
---

<MainLayout title="Blog" description="Blog posts and fun stuff" bare>
	<section class="wrap pb-12 pt-12 md:pt-16">
		<div class="mb-12 flex flex-col gap-5 md:mb-16 md:flex-row md:items-end md:justify-between">
			<div>
				<h1 class="sr-only">Blog</h1>
				<img src="/layout/blog-word.svg" class="-ml-3 h-28 w-auto -rotate-1 md:h-40" alt="" />
				<p class="mt-3 max-w-xl font-display text-[1.45rem] font-bold leading-[1.2] tracking-[-0.01em] text-white text-balance md:text-[1.75rem]">
					Hot takes on live media, QUIC, and building MoQ <span class="scribble scribble-2">in the open.</span>
				</p>
			</div>
			<a href="/rss.xml" class="btn-line shrink-0 self-start md:self-auto">
				RSS <span aria-hidden="true">→</span>
			</a>
		</div>

		<!-- The newest post gets the front page. -->
		<a href={latest.url} class="featured group reveal">
			<img class="aspect-video h-full w-full bg-slate-900 object-cover" src={latest.frontmatter.cover} alt="" />
			<div class="flex flex-col justify-center gap-3 p-6 md:p-10">
				<span class="label flex items-center gap-3">
					<span class="rounded-sm bg-green-500 px-1.5 py-0.5 font-semibold text-slate-950">Latest</span>
					{formatDate(latest.frontmatter.date)}
				</span>
				<span class="font-display text-[2rem] font-extrabold leading-[1.02] tracking-[-0.02em] text-white text-balance group-hover:text-green-500 md:text-[2.75rem]" style="font-stretch: 88%">
					{latest.frontmatter.title}
				</span>
				<span class="text-[1.05rem] leading-relaxed text-slate-400 text-pretty">{latest.frontmatter.description}</span>
				<span class="mt-2 font-display font-bold text-green-500">Read it <span aria-hidden="true" class="inline-block transition-transform group-hover:translate-x-1">→</span></span>
			</div>
		</a>

		{
			[...years].map(([year, list]) => (
				<div class="mt-20 md:mt-24">
					<h2 class="year">
						<span>{year}</span>
						<span class="h-0.5 flex-1 bg-slate-800" aria-hidden="true" />
						<span class="label">{list.length} {list.length === 1 ? "post" : "posts"}</span>
					</h2>
					<ul class="grid gap-7 sm:grid-cols-2 lg:grid-cols-3">
						{list.map((post) => (
							<li class="contents">
								<a href={post.url} class="polaroid group">
									<img class="mb-2 aspect-video w-full rounded-lg bg-slate-900 object-cover" src={post.frontmatter.cover} alt="" loading="lazy" />
									<span class="label px-1">{formatDate(post.frontmatter.date)}</span>
									<span class="px-1 font-display text-[1.35rem] font-bold leading-[1.12] tracking-[-0.01em] text-white text-balance group-hover:text-green-500">
										{post.frontmatter.title}
									</span>
									<span class="px-1 text-[0.95rem] leading-relaxed text-slate-400 text-pretty">{post.frontmatter.description}</span>
								</a>
							</li>
						))}
					</ul>
				</div>
			))
		}
	</section>
</MainLayout>

<style>
	@reference "../../layouts/global.css";

	.featured {
		@apply card grid overflow-hidden md:grid-cols-[1.35fr_1fr];
	}
	.year {
		@apply mb-10 flex items-center gap-5 font-display text-[2.6rem] font-extrabold leading-none tracking-[-0.02em] text-slate-500 md:text-[3.2rem];
		font-stretch: 84%;
	}
</style>
