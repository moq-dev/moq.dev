<UseCasePage
	title="Distribution"
	description="Sub-second live delivery at CDN scale, without giving up HTTP's economics or legacy HLS players."
	cover="/og/page/distribution.png"
	heading="Distribution"
	scribble="Distribution"
	pitch="Sub-second latency at CDN scale, with every viewer choosing its own buffer—and an HLS gateway so legacy players migrate one at a time."
