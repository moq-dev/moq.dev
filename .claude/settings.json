{
	"$schema": "https://json.schemastore.org/claude-code-settings.json",
	"hooks": {
		"SessionStart": [
			{
				"hooks": [
					{
						"type": "command",
						"command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/direnv.sh"
					}
				]
			}
		]
	},
	"permissions": {
		"allow": [
			"Bash(just *)",
			"Bash(bun *)",
			"Bash(bunx *)",
			"Bash(quest *)",
			"WebFetch(domain:moq.dev)",
			"WebFetch(domain:doc.moq.dev)",
			"WebFetch(domain:docs.astro.build)",
			"WebFetch(domain:developers.cloudflare.com)"
		],
		"ask": ["Bash(just deploy*)", "Bash(bun wrangler deploy*)", "Bash(bunx wrangler deploy*)"]
	}
}
